# Copy to .env.local and fill in values from the Supabase project dashboard.
# Never commit .env.local — it's covered by the .env* rule in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed to run `npm run seed` (scripts/seed.mjs). Service role key
# bypasses RLS — keep it out of the browser and out of NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=
