# Copy to .env.local and fill in values from the Supabase project dashboard.
# Never commit .env.local — it's covered by the .env* rule in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed to run e2e/auth.spec.ts (INC-1 fixture accounts).
E2E_STABLE_BHW_PASSWORD=
E2E_STABLE_ADMIN_PASSWORD=
E2E_OTHER_BARANGAY_BHW_PASSWORD=

# Only needed to run e2e/dashboard.spec.ts. Unlike the fixtures above,
# admin.city.stable is seeded by the INC-6 migration itself (idempotent —
# generated once, never regenerated on replay). The migration prints the
# generated password via RAISE NOTICE the first time it runs against a
# project; capture that output once and record it here / as a CI secret.
E2E_STABLE_CITY_ADMIN_PASSWORD=
