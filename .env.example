# Copy to .env.local and fill in values from the Supabase project dashboard.
# Never commit .env.local — it's covered by the .env* rule in .gitignore.
#
# To run the E2E suite locally, point these at the dedicated `bhw-connect-e2e`
# project (same one CI uses via the E2E_SUPABASE_URL/ANON_KEY secrets) —
# never at the pilot project. See docs/deploy-runbook.md's "CI test project"
# section for why, and for how the fixture accounts below are provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed to run e2e/auth.spec.ts (INC-1 fixture accounts).
E2E_STABLE_BHW_PASSWORD=
E2E_STABLE_ADMIN_PASSWORD=
E2E_OTHER_BARANGAY_BHW_PASSWORD=

# Only needed to run e2e/dashboard.spec.ts. Unlike the fixtures above,
# admin.city.stable is seeded by the INC-6 migration itself (idempotent —
# generated once, never regenerated on replay). The migration prints the
# generated password via RAISE NOTICE the first time it runs against a
# project; capture that output once and record it here / as a CI secret.
E2E_STABLE_CITY_ADMIN_PASSWORD=

# Error tracking (INC-9, §5.3). The app runs identically without these —
# Sentry.init's `enabled` flag is false until a DSN is set. SENTRY_DSN is
# used server/edge-side; NEXT_PUBLIC_SENTRY_DSN is the browser copy (same
# value, public by design — DSNs are not secret, just a submit endpoint).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI to upload source maps at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Retention-purge scheduled job (INC-9, §5.4) and the weekly backup job
# (INC-9, §5.3) run outside the app, via GitHub Actions — see
# docs/deploy-runbook.md and docs/restore-drill-runbook.md.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# External AI provider (INC-18a, docs/free-ai-leverage-plan.md §2). Optional —
# the app runs identically unset: the adapter reports "unavailable" and every
# AI feature falls back to its rule-based baseline (rule 2). Unlike every other
# secret here this one belongs in Vercel, not GitHub Actions: it is read at
# request time by the running app, and unit tests stub the transport rather
# than calling out. Gemini's free tier may use submitted data for training, so
# only admin-authored or admin-cleared content is ever sent — enforced by the
# data-classification gate in src/lib/ai/adapter.ts, not by policy.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash. Providers retire models on their own
# schedule — gemini-2.0-flash, which this project originally pinned in code,
# was shut down on 2026-06-01 and every call 404'd. Set this to move to a
# current model without a code change or a deploy.
GEMINI_MODEL=
