# Copy to .env.local and fill in values from the Supabase project dashboard.
# Never commit .env.local — it's covered by the .env* rule in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — full-privilege key, bypasses Row Level Security. Used by
# auth server actions (login throttling, forced password change, consent,
# audit logging) and scripts/seed-pilot.ts. Never expose to the browser
# (i.e. never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
