{
  "lessons": {
    "bhw-legal-role": {
      "module": "04-ra7883",
      "sections": {
        "status-and-other-processes": {
          "fil": {
            "src": "/training/audio/04-ra7883/bhw-legal-role/status-and-other-processes.fil.00a9f93629af.mp3",
            "voice": "gemini:gemini-3.8-flash-tts:Kore",
            "content_hash": "00a9f93629afe78c2af4255d8121eb7341d33fe5af74f195084dc7f1b285f66e",
            "sha256": "60b5cd17daadb5df72adfeec84d1f8735ce81a0ee0637dd98fcad66ae04569ae",
            "duration_seconds": 65.097,
            "timings": [
              {
                "zone": "heading",
                "index": 0,
                "text": "Katayuan, rehistrasyon at eligibility",
                "start_ms": 0,
                "end_ms": 3760
              },
              {
                "zone": "body",
                "index": 0,
                "text": "Sa seksiyon 4 ng RA 7883, ang rehistrasyon sa local health board ng lungsod o munisipyo kung saan naglilingkod ang BHW ay kailangan para sa mga benepisyo at insentibo sa batas.",
                "start_ms": 4060,
                "end_ms": 18220
              },
              {
                "zone": "body",
                "index": 1,
                "text": "Binabanggit din dito ang angkop na patunay ng akreditasyon.",
                "start_ms": 18520,
                "end_ms": 22880
              },
              {
                "zone": "body",
                "index": 2,
                "text": "May mga kondisyon pa ang bawat benepisyo; hindi sapat ang isang paanyaya upang mangako ng allowance.",
                "start_ms": 23180,
                "end_ms": 30500
              },
              {
                "zone": "body",
                "index": 3,
                "text": "Iba rin ang Barangay Health Worker Eligibility ng Civil Service Commission: may sariling kondisyon at aplikasyon ito.",
                "start_ms": 30800,
                "end_ms": 38000
              },
              {
                "zone": "body",
                "index": 4,
                "text": "Hindi awtomatikong appointment o propesyonal na lisensiya para sa gawaing klinikal ang akreditasyon bilang BHW.",
                "start_ms": 38300,
                "end_ms": 46940
              },
              {
                "zone": "body",
                "index": 5,
                "text": "Sa mga susunod na aralin tatalakayin ang benepisyo, eligibility at proseso ng akreditasyon.",
                "start_ms": 47240,
                "end_ms": 54440
              },
              {
                "zone": "body",
                "index": 6,
                "text": "Dito, unawain muna ang pagkakaiba at tamang awtoridad.",
                "start_ms": 54740,
                "end_ms": 59660
              },
              {
                "zone": "takeaway",
                "index": 0,
                "text": "Huwag gawing awtomatikong benepisyo o appointment ang akreditasyon.",
                "start_ms": 59960,
                "end_ms": 65040
              }
            ]
          }
        }
      }
    },
    "bhs-decline": {
      "module": "03-polisiya-bhs",
      "sections": {
        "section-4": {
          "fil": {
            "src": "/training/audio/03-polisiya-bhs/bhs-decline/section-4.fil.45daf8b7fee9.mp3",
            "voice": "gemini:gemini-3.8-flash-tts:Kore",
            "content_hash": "45daf8b7fee9ffd8199bb8419c5511a1cbd744d522bd5269286ed6474086a5ba",
            "sha256": "474bff533f5542ddb795060cd0b2e916c24f6a272027a77bea5e11537a397452",
            "duration_seconds": 65.724,
            "timings": [
              {
                "zone": "heading",
                "index": 0,
                "text": "Malinaw at magalang",
                "start_ms": 0,
                "end_ms": 2000
              },
              {
                "zone": "body",
                "index": 0,
                "text": "Bumalik ang isang bisita sa BHS.",
                "start_ms": 2300,
                "end_ms": 5220
              },
              {
                "zone": "body",
                "index": 1,
                "text": "May infant-formula samples para sa mga nanay, product poster, at personal na regalong kapalit ng tulong sa promosyon.",
                "start_ms": 5520,
                "end_ms": 14640
              },
              {
                "zone": "body",
                "index": 2,
                "text": "Alam ni Mimi na hindi niya tatanggapin ang alok na ito.",
                "start_ms": 14940,
                "end_ms": 18420
              },
              {
                "zone": "body",
                "index": 3,
                "text": "Paano niya sasabihin ang hindi nang may paggalang?",
                "start_ms": 18720,
                "end_ms": 21880
              },
              {
                "zone": "body",
                "index": 4,
                "text": "Sinabi ni Mimi: “Salamat po sa pagpunta.",
                "start_ms": 22180,
                "end_ms": 26100
              },
              {
                "zone": "body",
                "index": 5,
                "text": "Hindi ko po tatanggapin ang mga sample at regalo o ipapaskil ang product poster.",
                "start_ms": 26400,
                "end_ms": 31880
              },
              {
                "zone": "body",
                "index": 6,
                "text": "Saklaw ito ng Milk Code: hindi ginagamit ang pasilidad para sa ganitong promosyon, at hindi tinatanggap ang insentibong kapalit ng pagpromote.",
                "start_ms": 32180,
                "end_ms": 41460
              },
              {
                "zone": "body",
                "index": 7,
                "text": "Ipapaalam ko ang detalye sa aming midwife o namamahala.”",
                "start_ms": 41760,
                "end_ms": 46480
              },
              {
                "zone": "body",
                "index": 8,
                "text": "Hindi niya kinukuha ang mga bagay, ipinapalagay ang motibo ng bisita, o nangangakong may pahintulot mamaya.",
                "start_ms": 46780,
                "end_ms": 54500
              },
              {
                "zone": "body",
                "index": 9,
                "text": "Opsyonal ang kuwento; maaari mong tapusin ang Read o Slides nang hindi nanonood.",
                "start_ms": 54800,
                "end_ms": 60600
              },
              {
                "zone": "takeaway",
                "index": 0,
                "text": "Magalang na tono, malinaw na hindi, at tiyak na dahilan.",
                "start_ms": 60900,
                "end_ms": 65660
              }
            ]
          },
          "en": {
            "src": "/training/audio/03-polisiya-bhs/bhs-decline/section-4.en.2c3fdbbd3c60.mp3",
            "voice": "gemini:gemini-3.8-flash-tts:Kore",
            "content_hash": "2c3fdbbd3c603648823b7b2a62f035effb10f2c8a397f7338628e1dc12789893",
            "sha256": "2be9f0ac1b10d910bc01712fb7e7e021cbabbecb99bd2c889f75a6d88c8ec74a",
            "duration_seconds": 59.193,
            "timings": [
              {
                "zone": "heading",
                "index": 0,
                "text": "Clear and respectful",
                "start_ms": 0,
                "end_ms": 2320
              },
              {
                "zone": "body",
                "index": 0,
                "text": "A visitor returns to the BHS with infant-formula samples for mothers, a product poster, and a personal gift in return for promotion.",
                "start_ms": 2620,
                "end_ms": 14380
              },
              {
                "zone": "body",
                "index": 1,
                "text": "Mimi knows she will decline this offer.",
                "start_ms": 14680,
                "end_ms": 18200
              },
              {
                "zone": "body",
                "index": 2,
                "text": "How can she say no respectfully?",
                "start_ms": 18500,
                "end_ms": 21220
              },
              {
                "zone": "body",
                "index": 3,
                "text": "Mimi says: “Thank you for coming.",
                "start_ms": 21520,
                "end_ms": 24280
              },
              {
                "zone": "body",
                "index": 4,
                "text": "I will not accept the samples or gift, or display the product poster.",
                "start_ms": 24580,
                "end_ms": 29380
              },
              {
                "zone": "body",
                "index": 5,
                "text": "This falls under the Milk Code: the facility cannot be used for this promotion, and an inducement for promotion cannot be accepted.",
                "start_ms": 29680,
                "end_ms": 37800
              },
              {
                "zone": "body",
                "index": 6,
                "text": "I will tell our midwife or facility supervisor the details.”",
                "start_ms": 38100,
                "end_ms": 41660
              },
              {
                "zone": "body",
                "index": 7,
                "text": "She does not take the items, assume the visitor’s motives, or promise permission later.",
                "start_ms": 41960,
                "end_ms": 48160
              },
              {
                "zone": "body",
                "index": 8,
                "text": "The story is optional; you can complete Read or Slides without watching it.",
                "start_ms": 48460,
                "end_ms": 53340
              },
              {
                "zone": "takeaway",
                "index": 0,
                "text": "Use a respectful tone, a clear refusal, and a specific reason.",
                "start_ms": 53640,
                "end_ms": 59120
              }
            ]
          }
        }
      }
    },
    "bhw-roles-hepo": {
      "module": "01-tungkulin-ng-bhw",
      "sections": {
        "morning": {
          "fil": {
            "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-hepo/morning.fil.6863e894e5a9.mp3",
            "voice": "gemini:gemini-3.8-flash-tts:Kore",
            "content_hash": "6863e894e5a9877048f04fc382c229f49b43ac45fc85e8ba5a9b7adb89e161b9",
            "sha256": "26f6f181086edeafb36457b6aef1046a99998bc7f9a0d742b8529da8058f2c17",
            "duration_seconds": 52.114,
            "timings": [
              {
                "zone": "heading",
                "index": 0,
                "text": "Isang umaga, maraming gawain",
                "start_ms": 0,
                "end_ms": 3360
              },
              {
                "zone": "body",
                "index": 0,
                "text": "Alas-otso, may talakayang pangkalusugan si BHW Riza sa purok.",
                "start_ms": 3660,
                "end_ms": 9500
              },
              {
                "zone": "body",
                "index": 1,
                "text": "Alas-diyes, kausap niya ang kagawad tungkol sa clean-up drive.",
                "start_ms": 9800,
                "end_ms": 14520
              },
              {
                "zone": "body",
                "index": 2,
                "text": "Alas-onse, tinutulungan niya si Aling Nena na makausap ang midwife tungkol sa pangangailangan ng anak nito.",
                "start_ms": 14820,
                "end_ms": 22700
              },
              {
                "zone": "body",
                "index": 3,
                "text": "Iisang BHW ang gumagawa ng tatlo.",
                "start_ms": 23000,
                "end_ms": 26680
              },
              {
                "zone": "body",
                "index": 4,
                "text": "Sa curriculum, ang direksyon ng UHC ay mas matibay na primary care at health promotion; kaya mas malawak ang papel na ginagampanan ng mga BHW kaysa sa pagtulong lamang sa serbisyo.",
                "start_ms": 26980,
                "end_ms": 42300
              },
              {
                "zone": "takeaway",
                "index": 0,
                "text": "Kasama sa gawain ng BHW ang pagtuturo at pagkilos kasama ang komunidad, bukod sa pagtulong sa serbisyo.",
                "start_ms": 42600,
                "end_ms": 52040
              }
            ]
          }
        }
      }
    },
    "communication-clarify": {
      "module": "06-komunikasyon",
      "sections": {
        "open-question": {
          "fil": {
            "src": "/training/audio/06-komunikasyon/communication-clarify/open-question.fil.5d29c06e0f34.mp3",
            "voice": "gemini:gemini-3.8-flash-tts:Kore",
            "content_hash": "5d29c06e0f3487410711bc77f308c2db8f754bcb7261fa5bcb6cf1b8fa99bb9f",
            "sha256": "c3a11b7f96b6574ee8dafc3bbbe6b2dbfea475859a302003c1efc911edd341d7",
            "duration_seconds": 67.004,
            "timings": [
              {
                "zone": "heading",
                "index": 0,
                "text": "Maging bukas muna, hanapin ang linaw",
                "start_ms": 0,
                "end_ms": 3480
              },
              {
                "zone": "body",
                "index": 0,
                "text": "Si Gibs, lalaking BHW, ay nakikipag-usap kay Liza, 29 anyos, tungkol sa hindi niya pagpunta sa health center.",
                "start_ms": 3780,
                "end_ms": 14220
              },
              {
                "zone": "body",
                "index": 1,
                "text": "Kathang-isip ang kuwentong ito.",
                "start_ms": 14520,
                "end_ms": 16880
              },
              {
                "zone": "body",
                "index": 2,
                "text": "Napag-usapan na nila ang layunin, wika at komportableng lugar.",
                "start_ms": 17180,
                "end_ms": 21980
              },
              {
                "zone": "body",
                "index": 3,
                "text": "“Ano po ang nangyari noong hindi kayo nakapunta?”",
                "start_ms": 22280,
                "end_ms": 25440
              },
              {
                "zone": "body",
                "index": 4,
                "text": "tanong ni Gibs.",
                "start_ms": 25740,
                "end_ms": 27180
              },
              {
                "zone": "body",
                "index": 5,
                "text": "“Wala akong kasama,” sagot ni Liza.",
                "start_ms": 27480,
                "end_ms": 30640
              },
              {
                "zone": "body",
                "index": 6,
                "text": "Nagbigay siya ng oras para matapos ang kuwento.",
                "start_ms": 30940,
                "end_ms": 34140
              },
              {
                "zone": "body",
                "index": 7,
                "text": "Ang “Ibig ninyong sabihin, ayaw ninyong pumunta?”",
                "start_ms": 34440,
                "end_ms": 38200
              },
              {
                "zone": "body",
                "index": 8,
                "text": "ay may ipinapalagay nang motibo.",
                "start_ms": 38500,
                "end_ms": 41740
              },
              {
                "zone": "body",
                "index": 9,
                "text": "Ang bukas na paanyaya ay nagbibigay kay Liza ng pagkakataong magsabi sa sarili niyang salita.",
                "start_ms": 42040,
                "end_ms": 47880
              },
              {
                "zone": "body",
                "index": 10,
                "text": "Saka lamang maglinaw ng isang kailangang detalye.",
                "start_ms": 48180,
                "end_ms": 51220
              },
              {
                "zone": "body",
                "index": 11,
                "text": "Maaaring oo o hindi ang sagot kung isang tiyak na detalye ang kinukumpirma; hindi ito kapalit ng pakikinig sa kuwento.",
                "start_ms": 51520,
                "end_ms": 60040
              },
              {
                "zone": "takeaway",
                "index": 0,
                "text": "Bukas na paanyaya muna; saka isang tiyak at walang paratang na tanong.",
                "start_ms": 60340,
                "end_ms": 66940
              }
            ]
          }
        }
      }
    }
  }
}
