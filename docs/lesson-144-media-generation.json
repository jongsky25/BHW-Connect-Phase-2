        {
          "zone": "question",
          "index": 0,
          "text": "Who decides accreditation? Demi asks this question. Her status has not been established.",
          "start_ms": 0,
          "end_ms": 7240
        },
        {
          "zone": "board",
          "index": 1,
          "text": "The Local Health Board has the accreditation responsibility. Check the application and official decision record; hearsay is insufficient.",
          "start_ms": 7540,
          "end_ms": 16900
        },
        {
          "zone": "committee",
          "index": 2,
          "text": "A committee may handle screening and recommendations. Without a committee, the board facilitates the process. A recommendation is not automatic approval.",
          "start_ms": 17200,
          "end_ms": 27080
        },
        {
          "zone": "cards",
          "index": 3,
          "text": "Fictional Card B has a recommendation but no verified board decision. Identify what is missing; do not declare approval.",
          "start_ms": 27380,
          "end_ms": 35660
        },
        {
          "zone": "follow-up",
          "index": 4,
          "text": "Demi asks where to verify the official decision record and next step. Confirm the responsible contact with the local health office.",
          "start_ms": 35960,
          "end_ms": 44880
        },
        {
          "zone": "summary",
          "index": 5,
          "text": "Explain roles, distinguish known facts from missing information, then ask. A training certificate, BHWE or job is not a substitute for accreditation.",
          "start_ms": 45180,
          "end_ms": 57740
        }
