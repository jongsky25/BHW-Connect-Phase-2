  "original_check": {
    "prompt_fil": "Parehong 17 ang dalawang problema. Alin ang gagawin ng grupo?",
    "prompt_en": "Two problems both score 17. What should the group do?",
    "options": [
      {
        "fil": "Balikan ang ebidensya, urgency at resources bago magkasundo.",
        "en": "Revisit evidence, urgency and resources before agreeing."
      },
      {
        "fil": "Unahin ang unang nakasulat para mabilis.",
        "en": "Choose the first listed to save time."
      },
      {
        "fil": "Dagdagan ng isa ang gusto ng lider kahit walang bagong ebidensya.",
        "en": "Add one point to the leader’s preference without new evidence."
      }
    ],
    "correct_option_index": 0,
    "feedback_fil": "Ang unang sagot ay may batayan at bukas sa grupo. Ang pagkakasunod sa listahan at kagustuhan ng lider ay hindi dagdag na ebidensya. Kung may nangangailangan ng agarang pangangalaga, sundin agad ang referral protocol.",
    "feedback_en": "The first response is evidence-based and open to the group. List order and a leader’s preference are not additional evidence. Follow referral procedures immediately for someone needing urgent care."
  },
