  "original_check": {
    "prompt_fil": "Aling pahayag ang magandang simula ng pagsisiyasat?",
    "prompt_en": "Which statement is a useful starting point for investigation?",
    "options": [
      {
        "fil": "“Kailangan ng bagong poster ang lahat.”",
        "en": "“Everyone needs a new poster.”"
      },
      {
        "fil": "“Ayaw talaga nilang gumaling.”",
        "en": "“They do not want to get well.”"
      },
      {
        "fil": "“Tatlong pamilya ang hindi nakapunta; alamin ang hadlang sa bawat isa.”",
        "en": "“Three households missed visits; check each household’s barrier.”"
      }
    ],
    "correct_option_index": 2,
    "feedback_fil": "Ang ikatlong sagot ay tiyak at bukas sa ebidensya. Ang poster ay solusyong hindi pa nasusuri; ang pahayag tungkol sa kagustuhan ay husga, hindi obserbasyon.",
    "feedback_en": "The third statement is specific and open to evidence. A poster is an untested solution; the claim about motivation is a judgment, not an observation."
  },
