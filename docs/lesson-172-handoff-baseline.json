  "original_check": {
    "prompt_fil": "Sa ikalimang “bakit,” sinabi ng grupo na kulang sa kaalaman ang ina. Ano ang susunod?",
    "prompt_en": "At the fifth “why,” the group says the mother lacks knowledge. What next?",
    "options": [
      {
        "fil": "Itigil ang usapan dahil lima na ang tanong.",
        "en": "Stop because five questions have been asked."
      },
      {
        "fil": "Suriin ang ebidensya at ibang hadlang kasama ang pamilya at health team.",
        "en": "Check the evidence and other barriers with the family and health team."
      },
      {
        "fil": "Magplano agad ng lecture para sa lahat ng ina.",
        "en": "Immediately plan a lecture for every mother."
      }
    ],
    "correct_option_index": 1,
    "feedback_fil": "Ang ikalawang sagot ay sumusubok sa paliwanag bago kumilos. Hindi patunay ang bilang ng tanong. Ang lecture ay maaaring hindi tumugon sa transportasyon, kita o kakulangan sa serbisyo.",
    "feedback_en": "The second response tests the explanation before acting. The question count is not proof. A lecture may miss transport, income or service gaps."
  },
  "guided_minutes": 50,
  "module_guided_minutes": 180,
