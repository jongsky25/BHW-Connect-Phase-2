        {
          "zone": "purpose",
          "index": 0,
          "text": "Malou and fellow BHWs are preparing invitations. They have a purpose and deadline, but must clarify their roles.",
          "start_ms": 0,
          "end_ms": 8360
        },
        {
          "zone": "practices",
          "index": 1,
          "text": "Five practices guide them: shared purpose, clear roles, early communication, openness to feedback and respectful relationships.",
          "start_ms": 8660,
          "end_ms": 19780
        },
        {
          "zone": "agreement",
          "index": 2,
          "text": "They agree on the task, recipient and time. The colleague repeats the accepted role. Changes needing permission are checked.",
          "start_ms": 20080,
          "end_ms": 29240
        },
        {
          "zone": "handoff",
          "index": 3,
          "text": "A colleague cannot finish. Malou listens early. They clarify the remaining work and confirm who accepts it, without private reasons.",
          "start_ms": 29540,
          "end_ms": 38860
        },
        {
          "zone": "feedback",
          "index": 4,
          "text": "Malou gives a specific suggestion. She listens to the response and confirms that the agreed task is complete.",
          "start_ms": 39160,
          "end_ms": 47640
        },
        {
          "zone": "closing",
          "index": 5,
          "text": "For the next task, clarify roles, speak early, respect privacy and confirm acceptance and completion.",
          "start_ms": 47940,
          "end_ms": 56220
        }
      ],
