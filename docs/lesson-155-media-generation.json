      "beats": [
        {
          "zone": "busy",
          "index": 0,
          "text": "May paanyaya at pulong si Malou. Hindi niya kayang gawin ang lahat nang sabay. Tinitingnan niya ang oras at sariling kapasidad.",
          "start_ms": 0,
          "end_ms": 8400
        },
        {
          "zone": "reliable",
          "index": 1,
          "text": "Maaasahan si Malou dahil malinaw ang pangako at pagbalita. Humihinto sandali, inaayos ang oras at tinatapos ang isang gawain.",
          "start_ms": 8700,
          "end_ms": 19180
        },
        {
          "zone": "honest",
          "index": 2,
          "text": "Mapagkakatiwalaan siya dahil may prinsipyo. Matapat at maingat siya sa pagbalita: dalawampu ang handa at lima ang natitira.",
          "start_ms": 19480,
          "end_ms": 30120
        },
        {
          "zone": "adapt",
          "index": 3,
          "text": "Mas maaga na ang pulong. Tinitiyak ni Malou ang bagong oras at ipinapaliwanag ang natitira. Inaayos niya ang plano matapos makumpirma.",
          "start_ms": 30420,
          "end_ms": 40260
        },
        {
          "zone": "habit",
          "index": 4,
          "text": "Pumili siya ng isang gawi: isulat ang tatlong prayoridad bago magtrabaho sa tatlong araw ngayong linggo. Sa Biyernes, rerepasuhin niya ang resulta.",
          "start_ms": 40560,
          "end_ms": 51640
        },
        {
          "zone": "closing",
          "index": 5,
          "text": "Anim na kasanayan ang gabay sa sarili. Makatotohanan ang pangako, tapat ang ulat at may pagrepaso. Hindi kailangang akuin ang lahat.",
          "start_ms": 51940,
          "end_ms": 64700
        }
      ],
