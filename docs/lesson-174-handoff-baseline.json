  "original_check": {
    "prompt_fil": "Nagawa ang meeting ngunit hindi dumami ang nakarating. Ano ang tamang review?",
    "prompt_en": "The meeting happened but attendance did not improve. What review is useful?",
    "options": [
      {
        "fil": "Ituring na tagumpay dahil natapos ang meeting.",
        "en": "Declare success because the meeting finished."
      },
      {
        "fil": "Ulitin ang parehong plano nang walang bagong tanong.",
        "en": "Repeat the same plan without new questions."
      },
      {
        "fil": "Balikan ang hadlang at ihambing ang invitations at attendance bago magbago.",
        "en": "Recheck barriers and compare invitations with attendance before revising."
      }
    ],
    "correct_option_index": 2,
    "feedback_fil": "Ang ikatlong sagot ay sumusukat sa resulta. Ang meeting ay gawain, hindi patunay na nawala ang hadlang; ang basta pag-uulit ay maaaring maulit ang maling palagay.",
    "feedback_en": "The third response examines results. A meeting is an activity, not proof that a barrier disappeared; repetition may preserve the wrong assumption."
  },
  "guided_minutes": 50,
  "module_guided_minutes": 180,
