{
  "narration": {
    "organizer-scene": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/organizer-scene.ceb.54ac97828b8b.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "54ac97828b8b651969ce2c3efbc7049f10504385cd471846d494b0386d1f02dd",
      "sha256": "9506fc706833c1099a5a89e2e66db43ffccfde181d141f04c0f48bc096bde0b2",
      "duration_seconds": 37.328979591836735,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gikan sa nakita, padulong sa panaghisgot",
          "start_ms": 0,
          "end_ms": 3600
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Namatikdan ni BHW Riza ang natigom nga tubig sa tulo ka nataran.",
          "start_ms": 3900,
          "end_ms": 8860
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Nakig-istorya siya sa mga residente: unsa ang ilang namatikdan, ug kinsa pa ang angay nga makaapil sa panaghisgot?",
          "start_ms": 9160,
          "end_ms": 18200
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Miduol usab siya sa purok leader ug health staff.",
          "start_ms": 18500,
          "end_ms": 22620
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Isip Community Organizer, iyang gikonektar ang mga tawo sa dili pa magdesisyon bahin sa buluhatong buhaton nga magkauban.",
          "start_ms": 22920,
          "end_ms": 31440
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Paminaw ug ikonektar una ang mga tawo sa dili pa magdesisyon sa buluhaton.",
          "start_ms": 31740,
          "end_ms": 37260
        }
      ]
    },
    "participation": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/participation.ceb.7d0f0fa9efa9.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "7d0f0fa9efa9b3d63ba9cfa80e9608bc74016d99b28af621716f477864739e27",
      "sha256": "8ea11d0c7119ec751a434e9b13755ac24da156418663e8f759acc49fd89bdcd0",
      "duration_seconds": 41.116734693877554,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Dapita ang mga tawo nga moapil",
          "start_ms": 0,
          "end_ms": 2920
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Miingon si Riza: “Aduna koy namatikdang natigom nga tubig sa tulo ka nataran.",
          "start_ms": 3220,
          "end_ms": 9700
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mahimo ba kitang maghisgot uban sa purok leader ug health staff bahin sa atong mahimo?",
          "start_ms": 10000,
          "end_ms": 16440
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Kanus-a kamo makaapil?”",
          "start_ms": 16740,
          "end_ms": 18820
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Misugyot og laing oras ang usa ka residente.",
          "start_ms": 19120,
          "end_ms": 22960
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Gipaminaw kini ni Riza sa dili pa sila mopili og oras.",
          "start_ms": 23260,
          "end_ms": 27780
        },
        {
          "zone": "body",
          "index": 5,
          "text": "Sa pag-organisa, adunay kahigayonan ang mga residente nga mopahiangay sa buluhaton, dili lamang motambong niini.",
          "start_ms": 28080,
          "end_ms": 36040
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Adunay kahigayonan ang mga residente nga mopahiangay sa plano.",
          "start_ms": 36340,
          "end_ms": 41060
        }
      ]
    },
    "observation": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/observation.ceb.366acade45ea.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "366acade45ea7a5b1ff54822c0b07e3f68bf73982154c30800fbf8edd45ab4c3",
      "sha256": "471941f2d284d6df8a4d8c523f18daa7774a2edbfd36b4068e78bf6571cc7c0b",
      "duration_seconds": 41.012244897959185,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Isulti ang nakita, dili ang pangagpas",
          "start_ms": 0,
          "end_ms": 3680
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Gisulat ni Riza: “Adunay natigom nga tubig sa tulo ka nataran.”",
          "start_ms": 3980,
          "end_ms": 9860
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mao kana ang iyang nakita.",
          "start_ms": 10160,
          "end_ms": 12800
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Wala niya isulat nga ang tubig mao ang hinungdan sa pagkasakit sa mga bata; wala pa niya kana mapamatud-i.",
          "start_ms": 13100,
          "end_ms": 20780
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Gipaambit niya ang tin-aw nga obserbasyon ug ang kabalaka sa mga residente ngadto sa health staff aron mahisgotan ang angay nga sunod nga lakang.",
          "start_ms": 21080,
          "end_ms": 33200
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ipaambit ang nakita ug ang kabalaka; ayaw ipahayag ang hinungdan nga wala pa mapamatud-i.",
          "start_ms": 33500,
          "end_ms": 40940
        }
      ]
    },
    "planning-team": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/planning-team.ceb.8c153669c845.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "8c153669c8458b20d74127b46f0043d93097d45906afd760f4eebc99697c36eb",
      "sha256": "0f7b89a2798081ced49eb31394390fb1d86a6f5d6d8370e4ef915414ebdec05b",
      "duration_seconds": 37.773061224489794,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Dad-a ang nakita sa pagplano",
          "start_ms": 0,
          "end_ms": 2400
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Uban sa mga residente ug health staff, gitino ni Riza kon kinsa ang modala sa obserbasyon ngadto sa barangay planning team for health.",
          "start_ms": 2700,
          "end_ms": 13380
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Gitala nila ang nasabotang sugyot ug kon kinsa ang mopaabot sa tubag ngadto sa mga residente.",
          "start_ms": 13680,
          "end_ms": 20920
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Niining paagiha, maapil sa pagplano ang nakita ug mahibalo ang mga tawo sa nahimong sunod nga lakang.",
          "start_ms": 21220,
          "end_ms": 28500
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kumpirmaha sa health team ang aktuwal nga proseso sa inyong barangay.",
          "start_ms": 28800,
          "end_ms": 32920
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Tinoa kon kinsa ang modala sa isyu ug mopaabot sa tubag.",
          "start_ms": 33220,
          "end_ms": 37700
        }
      ]
    },
    "liph": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/liph.ceb.5ef2384450b8.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "5ef2384450b8f75785e1733f8bdbf069ae4a459ca133983d166d612fe2599873",
      "sha256": "494a9dd755b5b3522b92d16f1ca000b13691a89363651680676c9051a9303d03",
      "duration_seconds": 37.69469387755102,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Makatampo sa mas lapad nga plano",
          "start_ms": 0,
          "end_ms": 2960
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Mahimong makatabang ang kontribusyon sa barangay sa paghisgot sa mga panginahanglan sa panglawas alang sa Local Investment Plan for Health o LIPH sa siyudad o probinsya.",
          "start_ms": 3260,
          "end_ms": 18100
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ipaambit ang sugyot pinaagi sa kasamtangang lokal nga proseso uban sa health team.",
          "start_ms": 18400,
          "end_ms": 24840
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Dili awtomatikong mapondohan ang sugyot tungod lamang kay napaabot kini sa pagplano.",
          "start_ms": 25140,
          "end_ms": 30500
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mahimong makatabang sa LIPH ang kontribusyon sa barangay; walay garantiya sa pondo.",
          "start_ms": 30800,
          "end_ms": 37640
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/check.ceb.90cef6f1b2a6.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "90cef6f1b2a6e92cf0c6296863413311d3703409ce48c72fc639e2ceab9969eb",
      "sha256": "bdbdd94b7b6ef8349b75ea8ae35add511fc3d6a2be1d04a10254c7c473931f30",
      "duration_seconds": 26.90612244897959,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imong nakat-onan",
          "start_ms": 0,
          "end_ms": 2360
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Misugyot og laing oras ang mga residente alang sa panaghisgot.",
          "start_ms": 2660,
          "end_ms": 8060
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Miingon usab ang usa nga ang natigom nga tubig mao ang hinungdan sa pagkasakit sa mga bata.",
          "start_ms": 8360,
          "end_ms": 15320
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Unsa ang labing angay nga sunod buhaton ni Riza?",
          "start_ms": 15620,
          "end_ms": 19660
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Paminaw sa tubag, ireport ang nakita, ug dad-a ang isyu sa hustong lokal nga proseso.",
          "start_ms": 19960,
          "end_ms": 26840
        }
      ]
    }
  },
