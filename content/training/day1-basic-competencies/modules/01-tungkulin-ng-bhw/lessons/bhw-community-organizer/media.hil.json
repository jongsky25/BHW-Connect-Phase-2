{
  "narration": {
    "organizer-scene": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/organizer-scene.hil.c78448b517ee.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "c78448b517ee5718daf2f3ca89b27346b653961085bb96e4b2303d4bcdc39f05",
      "sha256": "14657be5c1ebe570221da2d9ffcc1b64b1f1f42055378a1fc547cf5f94b8d019",
      "duration_seconds": 36.075102040816326,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Halin sa nakita, padulong sa paghisugilanon",
          "start_ms": 0,
          "end_ms": 4080
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Natalupangdan ni BHW Riza ang natipon nga tubig sa tatlo ka lagwerta.",
          "start_ms": 4380,
          "end_ms": 9380
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Nakighambal siya sa mga residente: ano ang ila natalupangdan, kag sin-o pa ang dapat makaupod sa paghisugilanon?",
          "start_ms": 9680,
          "end_ms": 18040
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Nagpalapit man siya sa purok leader kag health staff.",
          "start_ms": 18340,
          "end_ms": 21580
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Bilang Community Organizer, ginaangot niya ang mga tawo antes magdesisyon parte sa buluhaton nga himuon nga mag-upod.",
          "start_ms": 21880,
          "end_ms": 30560
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Magpamati kag anguta anay ang mga tawo antes magdesisyon sa buluhaton.",
          "start_ms": 30860,
          "end_ms": 36020
        }
      ]
    },
    "participation": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/participation.hil.99ee8748059b.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "99ee8748059b0727ff3d0dacda89a511f550b03cf2eb3e7acb921377cac14298",
      "sha256": "d51c8ca9454c267fe26191dd7bb430fa7afa787f631c65dc706c96e3c3b144e7",
      "duration_seconds": 40.17632653061224,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Agdaha ang mga tawo nga makigbahin",
          "start_ms": 0,
          "end_ms": 3200
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Nagsiling si Riza: “May natalupangdan ako nga natipon nga tubig sa tatlo ka lagwerta.",
          "start_ms": 3500,
          "end_ms": 9620
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mahimo bala kita nga maghisugilanon upod sa purok leader kag health staff parte sa aton mahimo?",
          "start_ms": 9920,
          "end_ms": 16400
        },
        {
          "zone": "body",
          "index": 2,
          "text": "San-o kamo makaupod?”",
          "start_ms": 16700,
          "end_ms": 18820
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Nagsugyot sang lain nga oras ang isa ka residente.",
          "start_ms": 19120,
          "end_ms": 22640
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Ginpamatian ini ni Riza antes sila magpili sang oras.",
          "start_ms": 22940,
          "end_ms": 27460
        },
        {
          "zone": "body",
          "index": 5,
          "text": "Sa pag-organisa, may kahigayunan ang mga residente nga mag-angay sang buluhaton, indi lamang magtambong.",
          "start_ms": 27760,
          "end_ms": 35640
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "May kahigayunan ang mga residente nga mag-angay sang plano.",
          "start_ms": 35940,
          "end_ms": 40100
        }
      ]
    },
    "observation": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/observation.hil.1db79c4d497e.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "1db79c4d497ec6581d4c2cb4424e210f055c3b48abf59f86e18a58b1cc7279df",
      "sha256": "df0927815fa9ba5bc382334f3d1985b35041d140dd6256dca2084f4d7954e4be",
      "duration_seconds": 37.04163265306122,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Isugid ang nakita, indi ang pangagpas",
          "start_ms": 0,
          "end_ms": 3560
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Ginsulat ni Riza: “May natipon nga tubig sa tatlo ka lagwerta.”",
          "start_ms": 3860,
          "end_ms": 8820
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Amo ina ang iya nakita.",
          "start_ms": 9120,
          "end_ms": 11240
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Wala niya ginsulat nga ang tubig amo ang kabangdanan sang pagkabalatian sang mga bata; wala pa niya ina napamatud-an.",
          "start_ms": 11540,
          "end_ms": 19220
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ginpaambit niya ang maathag nga obserbasyon kag ang kabalaka sang mga residente sa health staff agod mahisugilanon ang nagakaigo nga masunod nga tikang.",
          "start_ms": 19520,
          "end_ms": 29760
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ipaambit ang nakita kag ang kabalaka; indi magpahayag sang kabangdanan nga wala pa napamatud-an.",
          "start_ms": 30060,
          "end_ms": 36980
        }
      ]
    },
    "planning-team": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/planning-team.hil.866d19b8ef46.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "866d19b8ef46cd4871fe2b6820c0900acd13a8781ee80fdd6cc7244b3337e74d",
      "sha256": "5a2b0804ea4638913a6e7c128b5a0a2591c2fe96f21d2537b34e2a6ea6217a78",
      "duration_seconds": 38.53061224489796,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Dal-a ang nakita sa pagplano",
          "start_ms": 0,
          "end_ms": 2640
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Upod sa mga residente kag health staff, gintukoy ni Riza kon sin-o ang magadala sang obserbasyon sa barangay planning team for health.",
          "start_ms": 2940,
          "end_ms": 12380
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Gintala nila ang ginkasugtan nga sugyot kag kon sin-o ang magabalik sang sabat sa mga residente.",
          "start_ms": 12680,
          "end_ms": 19440
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Sa sini nga pamaagi, nakaabot sa pagplano ang nakita kag nahibaluan sang mga tawo ang nahimo nga masunod nga tikang.",
          "start_ms": 19740,
          "end_ms": 28340
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kumpirmaha sa health team ang aktuwal nga proseso sa inyo barangay.",
          "start_ms": 28640,
          "end_ms": 33120
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Tukuyon kon sin-o ang magadala sang isyu kag magabalik sang sabat.",
          "start_ms": 33420,
          "end_ms": 38460
        }
      ]
    },
    "liph": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/liph.hil.562c937aeee2.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "562c937aeee2c20c723fc3e8f28da01623fbfa3e25f77ec67d93c08df6801de5",
      "sha256": "96dcde385c0d2cc158561bfe46d32c84943ebf93bfbdb85419029ec0d6bc3d96",
      "duration_seconds": 35.99673469387755,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Makaamot sa mas malapad nga plano",
          "start_ms": 0,
          "end_ms": 2840
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Mahimo nga makabulig ang amot sang barangay sa paghisugilanon sang mga kinahanglanon sa panglawas para sa Local Investment Plan for Health ukon LIPH sang siyudad ukon probinsya.",
          "start_ms": 3140,
          "end_ms": 15820
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ginapaambit ang sugyot paagi sa nagaluntad nga lokal nga proseso upod sa health team.",
          "start_ms": 16120,
          "end_ms": 23080
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Indi awtomatiko nga mapondohan ang sugyot tungod lamang kay napaabot ini sa pagplano.",
          "start_ms": 23380,
          "end_ms": 28940
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mahimo nga makabulig sa LIPH ang amot sang barangay; wala sang garantiya sa pondo.",
          "start_ms": 29240,
          "end_ms": 35920
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-community-organizer/check.hil.c8cbb8676d43.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "c8cbb8676d433f99c1b0de507c3d8b0a902fef9df2660162530b14f7a7ec18e1",
      "sha256": "9ff6b31d7911f90199a9a8b3a3a446261b095c100f547793a1c512a79d27cf57",
      "duration_seconds": 26.853877551020407,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imo natun-an",
          "start_ms": 0,
          "end_ms": 2600
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Nagsugyot sang lain nga oras ang mga residente para sa paghisugilanon.",
          "start_ms": 2900,
          "end_ms": 7820
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Nagsiling man ang isa nga ang natipon nga tubig amo ang kabangdanan sang pagkabalatian sang mga bata.",
          "start_ms": 8120,
          "end_ms": 14440
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ano ang pinakamaayo nga masunod nga himuon ni Riza?",
          "start_ms": 14740,
          "end_ms": 19100
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Magpamati sa sabat, ireport ang nakita, kag dal-a ang isyu sa husto nga lokal nga proseso.",
          "start_ms": 19400,
          "end_ms": 26800
        }
      ]
    }
  },
