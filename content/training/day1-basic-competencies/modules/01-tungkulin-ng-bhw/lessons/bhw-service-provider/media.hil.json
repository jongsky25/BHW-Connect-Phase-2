{
  "narration": {
    "first-contact": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/first-contact.hil.cf06b688e97c.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "cf06b688e97ce87b21b870acbbf8a722fcbec7af8ac66c000ee92ed95bdac0ce",
      "sha256": "2245fa3bc1963ad7725b83d99e3ccae44f62e2927d031f4060bd01e3baf97788",
      "duration_seconds": 37.48571428571429,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Si Riza ang una nga ginpalapitan",
          "start_ms": 0,
          "end_ms": 3040
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Nagpalapit si Aling Nena kay BHW Riza.",
          "start_ms": 3340,
          "end_ms": 7060
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Gusto niya mahibaluan kon sin-o ang iya makaistorya parte sa kinahanglanon sang iya anak.",
          "start_ms": 7360,
          "end_ms": 13280
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Bilang kabahin sang primary care team sang siyudad ukon munisipyo, kabulig si Riza sang midwife sa barangay.",
          "start_ms": 13580,
          "end_ms": 20940
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Mahimo nga siya ang una nga palapitan ni Aling Nena, pero indi niya kinahanglan nga sabton ukon bulngon ang tanan.",
          "start_ms": 21240,
          "end_ms": 30200
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mahimo nga ang BHW ang una nga palapitan; kabulig siya sang midwife kag health team.",
          "start_ms": 30500,
          "end_ms": 37420
        }
      ]
    },
    "clarify-need": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/clarify-need.hil.303c06c91880.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "303c06c91880e6b1f5f9438290b0d57e27c39adaf2efe5e86b62095cf1ec775f",
      "sha256": "bea4067c15a30c118c7065bcdc4b50b9984f5f62062432bec86057f1f3f34c5c",
      "duration_seconds": 35.5265306122449,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Magpamati antes maggiya",
          "start_ms": 0,
          "end_ms": 2560
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Namangkot si Riza: “Ano nga bulig ang inyo kinahanglan, kag may nakaistorya na bala kamo nga health worker?”",
          "start_ms": 2860,
          "end_ms": 10860
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ginhatagan niya sang tion si Aling Nena nga magpaathag kag ginsulit ang iya nahangpan.",
          "start_ms": 11160,
          "end_ms": 17320
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Wala siya nagapangagpas kon ano ang balatian ukon ang pagbulong nga kinahanglan sini.",
          "start_ms": 17620,
          "end_ms": 23780
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ang maathag nga kinahanglanon makabulig sa health team sa paghatag sang nagakaigo nga giya.",
          "start_ms": 24080,
          "end_ms": 30240
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Magpamati kag klaruhon ang kinahanglanon antes maggiya.",
          "start_ms": 30540,
          "end_ms": 35460
        }
      ]
    },
    "boundaries": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/boundaries.hil.83385496c09f.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "83385496c09f3ba65cff67639037c26e1894a42b0f9569595ad9ce247705260c",
      "sha256": "eddfccc2e5483c51bbd79b8e364d3835f2743d31fca5d56b988604dc1237fced",
      "duration_seconds": 46.08,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Hibalua ang sakop sang imo buluhaton",
          "start_ms": 0,
          "end_ms": 3320
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Mga halimbawa sang pauna nga serbisyo ang pagpamangkot sa residente, pagsukod sang vital signs, pagrekord, paghimo sang household profile, kag pauna nga bulig.",
          "start_ms": 3620,
          "end_ms": 16540
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Himuon lamang ang sakop sang imo paghanas, lokal nga patakaran, kag kinahanglan nga pagdumala.",
          "start_ms": 16840,
          "end_ms": 23560
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Wala nagatudlo ini nga leksiyon sang pagsukod, pauna nga bulig, ukon pagbulong.",
          "start_ms": 23860,
          "end_ms": 30220
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kon lampas ini sa imo sakop ukon indi ka sigurado, magpangayo sang giya sa midwife ukon health team.",
          "start_ms": 30520,
          "end_ms": 37760
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mga halimbawa lamang ang pauna nga serbisyo; sundon ang paghanas, lokal nga patakaran, kag pagdumala.",
          "start_ms": 38060,
          "end_ms": 46020
        }
      ]
    },
    "guide": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/guide.hil.d64b37c11db8.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "d64b37c11db80466bf246a384c05f3e4b20b584f77581579a35b7afa90054dc5",
      "sha256": "f5e589a3fe5747125c9a09284f0c25247ea654ed419a1211a9f1a8ad28aa1914",
      "duration_seconds": 48.79673469387755,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Isugid ang maathag nga masunod nga tikang",
          "start_ms": 0,
          "end_ms": 3200
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Ginkumpirma ni Riza kon diin nga health worker ukon pasilidad ang nagakaigo nga palapitan suno sa lokal nga kahimusan.",
          "start_ms": 3500,
          "end_ms": 12380
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ginpaathag niya kay Aling Nena kon sin-o ang iya makaistorya kag paano magkadto didto.",
          "start_ms": 12680,
          "end_ms": 18880
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Mahimo niya isiling: “Mangusisa ako sa health team kon sin-o ang inyo makaistorya kag paano kamo makakadto didto.”",
          "start_ms": 19180,
          "end_ms": 27300
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ginsiguro niya nga nahangpan ni Aling Nena ang masunod nga tikang.",
          "start_ms": 27600,
          "end_ms": 32760
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Sundon ang lokal nga referral kag emergency procedures kon nagakaigo; indi pareho ang agyan sa tanan nga lugar ukon sitwasyon.",
          "start_ms": 33060,
          "end_ms": 42460
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Kumpirmaha kon sin-o ang palapitan kag ipaathag ang maathag nga masunod nga tikang.",
          "start_ms": 42760,
          "end_ms": 48720
        }
      ]
    },
    "follow-up": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/follow-up.hil.3d8f7fc5fb5f.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "3d8f7fc5fb5ff76dcae4424d69dbf047b9ae4300bd61082d9766352b61093a5a",
      "sha256": "e0d3e4131208a8d7274503adfb557db850bc76c72d69173e4d7c12dbc7bcadb2",
      "duration_seconds": 35.84,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Mag-follow-up upod sa health team",
          "start_ms": 0,
          "end_ms": 2680
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Indi matapos ang pagbulig sa pagtudlo kon diin makadto.",
          "start_ms": 2980,
          "end_ms": 7300
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Suno sa tagubilin sang health team, ginkumpirma ni Riza kon ano ang dapat bantayan ukon irekord, san-o siya mag-follow-up, kag kay sin-o siya magareport.",
          "start_ms": 7600,
          "end_ms": 18760
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Wala siya nag-imbento sang resulta ukon nagsaad nga wala na sang kinahanglan himuon.",
          "start_ms": 19060,
          "end_ms": 24820
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Hisugilanon sa masunod nga leksiyon ang mga partikular nga rekord kag form.",
          "start_ms": 25120,
          "end_ms": 30280
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Kumpirmaha kon ano, san-o, kag kay sin-o magareport suno sa health team.",
          "start_ms": 30580,
          "end_ms": 35780
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/check.hil.de56fc3c8278.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "de56fc3c8278f328107a8e052bcdb68e123467975e59af465725430d794af7c3",
      "sha256": "8b20f5095587b5990bbc5ce9f0a0968ec922f84c45c5a4d593ead298bda344ea",
      "duration_seconds": 24.86857142857143,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imo natun-an",
          "start_ms": 0,
          "end_ms": 2600
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Ginpamangkot ni Aling Nena si Riza kon ano nga bulong ang ihatag sa iya anak.",
          "start_ms": 2900,
          "end_ms": 8740
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Indi sakop sang paghanas ni Riza ang paghatag sina nga laygay.",
          "start_ms": 9040,
          "end_ms": 13640
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ano ang pinakamaayo niya nga himuon?",
          "start_ms": 13940,
          "end_ms": 16700
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Magpamati, magpabilin sa imo sakop, maggiya, kag mag-follow-up upod sa health team.",
          "start_ms": 17000,
          "end_ms": 24800
        }
      ]
    }
  },
