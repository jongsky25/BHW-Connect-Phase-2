{
  "narration": {
    "first-contact": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/first-contact.ceb.d7d42780c308.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "d7d42780c3083b99b485a7e4ebd63c4ece8a9b41561d1fcba0903d24b2304065",
      "sha256": "8632e37cd5784a571d95be83961cf51dbdbeffd5e7821f725159580460cddfa9",
      "duration_seconds": 38.89632653061224,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Si Riza ang unang giduolan",
          "start_ms": 0,
          "end_ms": 2840
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Miduol si Aling Nena kang BHW Riza.",
          "start_ms": 3140,
          "end_ms": 7100
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Gusto niyang mahibaloan kon kinsa ang iyang makaistorya bahin sa panginahanglan sa iyang anak.",
          "start_ms": 7400,
          "end_ms": 14120
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Isip kabahin sa primary care team sa siyudad o munisipyo, kaabag si Riza sa midwife sa barangay.",
          "start_ms": 14420,
          "end_ms": 22380
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Mahimong siya ang unang duolan ni Aling Nena, apan dili kinahanglan nga tubagon o tambalan niya ang tanan.",
          "start_ms": 22680,
          "end_ms": 31680
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mahimong ang BHW ang unang duolan; kaabag siya sa midwife ug health team.",
          "start_ms": 31980,
          "end_ms": 38820
        }
      ]
    },
    "clarify-need": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/clarify-need.ceb.220688519dc1.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "220688519dc1091da480cfbde8e6d506807f61521057aeb1fb8727b53f08b450",
      "sha256": "3e9dff926e441d600b3d7fc659abb2367b97bbd58687ef472a1035cee4035464",
      "duration_seconds": 33.72408163265306,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Paminaw sa dili pa mogiya",
          "start_ms": 0,
          "end_ms": 2080
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Nangutana si Riza: “Unsa nga tabang ang inyong gikinahanglan, ug nakig-istorya na ba kamo sa health worker?”",
          "start_ms": 2380,
          "end_ms": 9980
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Gihatagan niya og panahon si Aling Nena nga mopasabot ug gisubli ang iyang nasabtan.",
          "start_ms": 10280,
          "end_ms": 16680
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Wala siya mangagpas kon unsa ang sakit o ang gikinahanglan nga pagtambal.",
          "start_ms": 16980,
          "end_ms": 22740
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ang tin-aw nga panginahanglan makatabang sa health team sa paghatag og angay nga giya.",
          "start_ms": 23040,
          "end_ms": 29520
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Paminaw ug klaroha ang panginahanglan sa dili pa mogiya.",
          "start_ms": 29820,
          "end_ms": 33660
        }
      ]
    },
    "boundaries": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/boundaries.ceb.bc4be4576b01.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "bc4be4576b015ed9b3b9e5d1a092d315bd195e147e77b0cfd31858fc033c5930",
      "sha256": "19a2158dc19264ff5e4b2f6260743b39ce3197f377ca9fb23bf0ff36e5437902",
      "duration_seconds": 43.12816326530612,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Hibaloa ang sakop sa imong buluhaton",
          "start_ms": 0,
          "end_ms": 2960
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Mga pananglitan sa unang serbisyo ang pagpangutana sa residente, pagsukod sa vital signs, pagrekord, paghimo og household profile, ug unang tabang.",
          "start_ms": 3260,
          "end_ms": 14540
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Buhata lamang ang sakop sa imong pagsasanay, lokal nga patakaran, ug gikinahanglang pagdumala.",
          "start_ms": 14840,
          "end_ms": 21960
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Dili kini nga leksiyon motudlo sa pagsukod, unang tabang, o pagtambal.",
          "start_ms": 22260,
          "end_ms": 28060
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kon lapas kini sa imong sakop o dili ka sigurado, pangayo og giya sa midwife o health team.",
          "start_ms": 28360,
          "end_ms": 35120
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mga pananglitan lamang ang unang serbisyo; sunda ang pagsasanay, lokal nga patakaran, ug pagdumala.",
          "start_ms": 35420,
          "end_ms": 43060
        }
      ]
    },
    "guide": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/guide.ceb.006a314db19a.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "006a314db19a8feb7e58d3fd304814031b612c9f1f57aa6a7a85566e2955f83d",
      "sha256": "5352c80d5bf1363b5c1b7df67b5adf7b604eee6351f1e7e572968d09c9032e09",
      "duration_seconds": 46.65469387755102,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Isulti ang tin-aw nga sunod nga lakang",
          "start_ms": 0,
          "end_ms": 3760
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Gikumpirma ni Riza kon unsang health worker o pasilidad ang angay duolan sumala sa lokal nga kahikayan.",
          "start_ms": 4060,
          "end_ms": 11060
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Gipasabot niya kang Aling Nena kon kinsa ang iyang makaistorya ug unsaon pag-adto didto.",
          "start_ms": 11360,
          "end_ms": 18360
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Mahimo niyang isulti: “Mangutana ako sa health team kon kinsa ang inyong makaistorya ug unsaon ninyo pag-adto didto.”",
          "start_ms": 18660,
          "end_ms": 27420
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Gisiguro niya nga nasabtan ni Aling Nena ang sunod nga lakang.",
          "start_ms": 27720,
          "end_ms": 31520
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Sunda ang lokal nga referral ug emergency procedures kon angay; dili pareho ang agianan sa tanang lugar o sitwasyon.",
          "start_ms": 31820,
          "end_ms": 40580
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Kumpirmaha kon kinsa ang duolan ug ipasabot ang tin-aw nga sunod nga lakang.",
          "start_ms": 40880,
          "end_ms": 46600
        }
      ]
    },
    "follow-up": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/follow-up.ceb.9e80d3c47cd9.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "9e80d3c47cd944ac71b77a4c44fd5615fddd0c8076fb5276713691f3e8dd669e",
      "sha256": "6fec37375a112e2d882bf339759cbe1e36b5ac38b646ddf889322a27ada25fa1",
      "duration_seconds": 37.64244897959183,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Mag-follow-up uban sa health team",
          "start_ms": 0,
          "end_ms": 2920
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Dili matapos ang pagtabang sa pagtudlo kon asa moadto.",
          "start_ms": 3220,
          "end_ms": 7780
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Sumala sa tagubilin sa health team, gikumpirma ni Riza kon unsa ang angay bantayan o irekord, kanus-a siya mag-follow-up, ug kang kinsa siya moreport.",
          "start_ms": 8080,
          "end_ms": 19200
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Wala siya mag-imbento og resulta o mosaad nga wala nay kinahanglan buhaton.",
          "start_ms": 19500,
          "end_ms": 25340
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Hisgotan sa sunod nga leksiyon ang piho nga mga rekord ug form.",
          "start_ms": 25640,
          "end_ms": 30480
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Kumpirmaha kon unsa, kanus-a, ug kang kinsa moreport sumala sa health team.",
          "start_ms": 30780,
          "end_ms": 37580
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-service-provider/check.ceb.edcd06a1e419.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "edcd06a1e419c175980d77415c48f4b41ec4d9528504bf190a3069adae0dddb5",
      "sha256": "ff4d83b9958a184cf828b4df47d5f3b8b72008339f35fe5964f262717be3bb47",
      "duration_seconds": 25.33877551020408,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imong nakat-onan",
          "start_ms": 0,
          "end_ms": 2360
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Gipangutana ni Aling Nena si Riza kon unsang tambal ang ihatag sa iyang anak.",
          "start_ms": 2660,
          "end_ms": 8820
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Dili sakop sa pagsasanay ni Riza ang paghatag nianang tambaga.",
          "start_ms": 9120,
          "end_ms": 14280
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Unsa ang labing angay niyang buhaton?",
          "start_ms": 14580,
          "end_ms": 17660
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Paminaw, pagpabilin sulod sa imong sakop, paggiya, ug pag-follow-up uban sa health team.",
          "start_ms": 17960,
          "end_ms": 25280
        }
      ]
    }
  },
