{
  "narration": {
    "educator-scene": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/educator-scene.ceb.7d9fbfa3883c.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "7d9fbfa3883c700391c319554c8750c0cc0042acb84f52fb14fc6f75294c4067",
      "sha256": "9579b54ab6b46764de0036b5ec4bbc835909e7ca6d5188e8b5e4512b42d3c30d",
      "duration_seconds": 32.757551020408165,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Sugdi sa imong kaistorya",
          "start_ms": 0,
          "end_ms": 2920
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Sa usa ka panaghisgot bahin sa panglawas sa barangay, dili lang basahon ni Riza ang poster.",
          "start_ms": 3220,
          "end_ms": 10140
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Susihon una niya ang mga pangutana sa mga residente, dayon mohatag og klarong pasabot.",
          "start_ms": 10440,
          "end_ms": 16760
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Isip Health Educator, tabangan niya ang mga tawo nga makat-on kon unsaon pag-atiman sa ilang lawas ug pagpabiling limpyo sa palibot.",
          "start_ms": 17060,
          "end_ms": 27700
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ang pagtudlo usa ka panaghisgot nga adunay tumong.",
          "start_ms": 28000,
          "end_ms": 32680
        }
      ]
    },
    "body-environment": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/body-environment.ceb.cf1995a6ad3c.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "cf1995a6ad3c1c756dc1f33ab356bc14c91b21231b08a67eff0ed28bf27c305f",
      "sha256": "79839cd49623a4d3f90560a2eb54293467736cdfa0c798541a731f118a9c7955",
      "duration_seconds": 41.09061224489796,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Lawas ug palibot",
          "start_ms": 0,
          "end_ms": 2320
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Mahimong hisgotan sa edukasyon bahin sa panglawas ang pag-atiman sa lawas ug ang kalimpyo sa palibot.",
          "start_ms": 2620,
          "end_ms": 9980
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mahimo usab nga ipasabot ni Riza kon unsaon sa mga residente pagduol sa serbisyo sa panglawas.",
          "start_ms": 10280,
          "end_ms": 19040
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Mogamit siya og materyal nga giaprobahan sa health team.",
          "start_ms": 19340,
          "end_ms": 23940
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Niining leksiyon, iyang gipunting ang pagpili sa paksa ug sa kaistorya; ang detalyadong tambag bahin sa panglawas anaa sa angay nga pagbansay.",
          "start_ms": 24240,
          "end_ms": 36080
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Magkakonektar ang panglawas sa tawo ug ang iyang palibot.",
          "start_ms": 36380,
          "end_ms": 41020
        }
      ]
    },
    "life-stages": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/life-stages.ceb.cadd85a32fa1.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "cadd85a32fa1e87584e583346667a14ae2bf38959ad5a4b42a03532427f9e849",
      "sha256": "725a5cb7a28a684310d3360a2851f6026cb85db5c13d411611330949ea5c47af",
      "duration_seconds": 47.07265306122449,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Lahi ang panginahanglan sa matag yugto",
          "start_ms": 0,
          "end_ms": 3400
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Ipahiangay sa BHW ang edukasyon bahin sa panglawas sa lainlaing yugto sa kinabuhi.",
          "start_ms": 3700,
          "end_ms": 11620
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mahimong magkalahi ang mga pangutana sa tig-atiman sa masuso, kabatan-onan, mabdos, ug tigulang.",
          "start_ms": 11920,
          "end_ms": 20320
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Kinahanglang ipahiangay sa yugto sa kinabuhi sa kaistorya ang panaghisgot bahin sa sakit, aksidente, ug risgo.",
          "start_ms": 20620,
          "end_ms": 30220
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Pananglitan, mahimong lahi ang pangutana sa kabatan-onan ug sa tig-atiman sa masuso bahin sa risgo sa panglawas.",
          "start_ms": 30520,
          "end_ms": 39280
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ipahiangay sa yugto sa kinabuhi ang panaghisgot bahin sa sakit, aksidente, ug risgo.",
          "start_ms": 39580,
          "end_ms": 47020
        }
      ]
    },
    "all-sectors": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/all-sectors.ceb.c6dbad196900.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "c6dbad1969008b1e4aff8731c48b1f28cc48acd791a0eb135f8c3d67d09ebcc9",
      "sha256": "42dae43b850f7ee82512d4d0d1cbd93a8e316bc6035a01458c64ea1793e0582f",
      "duration_seconds": 42.605714285714285,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Maabot ang matag grupo",
          "start_ms": 0,
          "end_ms": 2400
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Dili lamang ang mga mitambong na sa health talk ang kinahanglang maabot.",
          "start_ms": 2700,
          "end_ms": 8460
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Hunahunaa kon kinsa ang wala makaapil: mga bata, kabatan-onan, tigulang, ug ubang grupo sa barangay.",
          "start_ms": 8760,
          "end_ms": 18200
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Pagpili og oras, lugar, pinulongan, ug pamaagi nga makatabang kanila nga moapil.",
          "start_ms": 18500,
          "end_ms": 26260
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Paghatag og impormasyon, kahibalo, ug kahigayonan sa pagpraktis.",
          "start_ms": 26560,
          "end_ms": 32560
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Kinahanglang mohatag ang BHW og impormasyon, kahibalo, ug kahigayonan sa pagpraktis sa matag grupo sa komunidad.",
          "start_ms": 32860,
          "end_ms": 42540
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/check.ceb.f6771743258f.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "f6771743258fdc8550b1374780f25468d40a802d5b32194885952190d6051ffb",
      "sha256": "492867556f4e2d9322e88b09dbbc314f6a3da45774c6155dc42d8443decdd0a2",
      "duration_seconds": 25.75673469387755,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imong nakat-onan",
          "start_ms": 0,
          "end_ms": 2360
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Nagpahigayon si Riza og panaghisgot bahin sa panglawas sa barangay, apan mga ginikanan lamang ang mitambong.",
          "start_ms": 2660,
          "end_ms": 11140
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Unsay mahimo niyang usbon aron makaapil ang kabatan-onan?",
          "start_ms": 11440,
          "end_ms": 16000
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mas epektibo ang pagtudlo kon ang paksa ug pamaagi angay sa kaistorya ug adunay kahigayonan nga makaapil siya.",
          "start_ms": 16300,
          "end_ms": 25700
        }
      ]
    }
  },
