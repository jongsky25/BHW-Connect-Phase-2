{
  "narration": {
    "educator-scene": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/educator-scene.hil.ee3fd911d7dd.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "ee3fd911d7dd41d549ec448aa5e1666ec990b4b1781c83f8150538af0fd154ad",
      "sha256": "6307c30cf91af8c9ba0e9dd9e631a18344722856e04dec693d05d972488d33ef",
      "duration_seconds": 33.25387755102041,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Magsugod sa imo kaistorya",
          "start_ms": 0,
          "end_ms": 2600
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Sa isa ka paghisugilanon parte sa panglawas sa barangay, indi lamang ginabasa ni Riza ang poster.",
          "start_ms": 2900,
          "end_ms": 9900
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ginausisa anay niya ang mga pamangkot sang mga residente, dayon nagahatag sang maathag nga pagpaathag.",
          "start_ms": 10200,
          "end_ms": 18320
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Bilang Health Educator, ginabuligan niya ang mga tawo nga matun-an kon paano atipanon ang ila lawas kag huptan nga matinlo ang palibot.",
          "start_ms": 18620,
          "end_ms": 28940
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ang pagtudlo isa ka paghisugilanon nga may katuyuan.",
          "start_ms": 29240,
          "end_ms": 33200
        }
      ]
    },
    "body-environment": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/body-environment.hil.32cc2f439e41.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "32cc2f439e41dacc9bbd7c18e9af8a3b991645415af2e0396bac17b7b2366836",
      "sha256": "97ef8f422550bd6d3197842d03bf471d664bc6a75bc2ee4ccc4251f9ebccdb58",
      "duration_seconds": 40.202448979591836,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Lawas kag palibot",
          "start_ms": 0,
          "end_ms": 2480
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Mahimo nga talakayon sa edukasyon parte sa panglawas ang pag-atipan sang lawas kag ang katinlo sang palibot.",
          "start_ms": 2780,
          "end_ms": 11340
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mahimo man nga ipaathag ni Riza kon paano makapalapit ang mga residente sa serbisyo sa panglawas.",
          "start_ms": 11640,
          "end_ms": 18880
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Nagagamit siya sang materyal nga gin-aprobahan sang health team.",
          "start_ms": 19180,
          "end_ms": 23380
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Sa sini nga leksiyon, nagatutok siya sa pagpili sang topiko kag sang kaistorya; ang detalyado nga laygay parte sa panglawas ara sa nagakaigo nga paghanas.",
          "start_ms": 23680,
          "end_ms": 35880
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Nagaangot ang panglawas sang tawo kag ang iya palibot.",
          "start_ms": 36180,
          "end_ms": 40140
        }
      ]
    },
    "life-stages": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/life-stages.hil.d65e4bf98848.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "d65e4bf988482ce7470a57c1566d6244d794c491e21cc22542d69258201b46f8",
      "sha256": "f2c1ac51f5a6f22d1e19dd8a8ffaeabcc857deb82148e8d8790b678622212561",
      "duration_seconds": 46.81142857142857,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Nagabag-o ang kinahanglanon sa tagsa ka yugto",
          "start_ms": 0,
          "end_ms": 3720
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Ginaangay sang BHW ang edukasyon parte sa panglawas sa lainlain nga yugto sang kabuhi.",
          "start_ms": 4020,
          "end_ms": 10780
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mahimo nga magkalainlain ang mga pamangkot sang naga-atipan sang lapsag, pamatan-on, nagabusong, kag tigulang.",
          "start_ms": 11080,
          "end_ms": 19720
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Kinahanglan nga iangay sa yugto sang kabuhi sang kaistorya ang paghisugilanon parte sa balatian, aksidente, kag risgo.",
          "start_ms": 20020,
          "end_ms": 28580
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Halimbawa, mahimo nga magkalain ang pamangkot sang pamatan-on kag sang naga-atipan sang lapsag parte sa risgo sa panglawas.",
          "start_ms": 28880,
          "end_ms": 38680
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Iangay sa yugto sang kabuhi ang paghisugilanon parte sa balatian, aksidente, kag risgo.",
          "start_ms": 38980,
          "end_ms": 46740
        }
      ]
    },
    "all-sectors": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/all-sectors.hil.0d9ce149b29c.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "0d9ce149b29cb6ecfbc49bd696d1046c3759eed3921a34533bd636d96446edcd",
      "sha256": "590b365bfd258da35c0ffb5ae9da4730917e1ef5030bdf44077d013a1204387e",
      "duration_seconds": 41.48244897959184,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Lab-uta ang tagsa ka grupo",
          "start_ms": 0,
          "end_ms": 2720
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Indi lamang ang mga nagatambong na sa health talk ang kinahanglan nga malab-ot.",
          "start_ms": 3020,
          "end_ms": 8060
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Hunahunaa kon sin-o ang wala pa makaupod: mga bata, pamatan-on, tigulang, kag iban pa nga grupo sa barangay.",
          "start_ms": 8360,
          "end_ms": 17320
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Magpili sang oras, lugar, pinulongan, kag pamaagi nga makabulig sa ila nga makigbahin.",
          "start_ms": 17620,
          "end_ms": 25220
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Maghatag sang impormasyon, ihibalo, kag kahigayunan sa paghanas.",
          "start_ms": 25520,
          "end_ms": 31240
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Kinahanglan maghatag ang BHW sang impormasyon, ihibalo, kag kahigayunan sa paghanas sa tagsa ka grupo sang komunidad.",
          "start_ms": 31540,
          "end_ms": 41420
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-health-educator/check.hil.affb810ad8d9.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "affb810ad8d963dd48a86dbe73f25613a13bb1681855b58c4a9db2b8123c297b",
      "sha256": "40bd7418156c4a0da717d909f9b05a9ce118d5de18e16b20085af20132fe7e01",
      "duration_seconds": 25.808979591836735,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imo natun-an",
          "start_ms": 0,
          "end_ms": 2600
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Naghiwat si Riza sang paghisugilanon parte sa panglawas sa barangay, pero mga ginikanan lamang ang nagtambong.",
          "start_ms": 2900,
          "end_ms": 10540
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ano ang mahimo niya nga bag-uhon agod makaupod ang mga pamatan-on?",
          "start_ms": 10840,
          "end_ms": 16080
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mas epektibo ang pagtudlo kon ang topiko kag pamaagi nagakaigo sa kaistorya kag may kahigayunan siya nga makigbahin.",
          "start_ms": 16380,
          "end_ms": 25740
        }
      ]
    }
  },
