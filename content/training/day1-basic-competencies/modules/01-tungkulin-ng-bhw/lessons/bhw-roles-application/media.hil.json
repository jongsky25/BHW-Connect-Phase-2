{
  "narration": {
    "applied-observation": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/applied-observation.hil.03a5568fa56b.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "03a5568fa56bd4a78c0b16e7c110cf0f04ace6923346973bf1eb4faa6cc5bcb6",
      "sha256": "440622d8764d82e6c26b9338afd8fdfc9e5eec159d21d73035a6bf15ba19ab94",
      "duration_seconds": 48.22204081632653,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Isa ka obserbasyon, tatlo ka katungdanan",
          "start_ms": 0,
          "end_ms": 3960
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Sa pagbisita sa purok, natalupangdan ni BHW Riza ang tubig nga nagtipon sa tatlo ka lagwerta.",
          "start_ms": 4260,
          "end_ms": 11140
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Tagubilin sang midwife: “Irekord ang nakita, ipamangkot kon may gusto makaistorya ang health team, kag ireport sa akon ang aksyon nga kinahanglan pa.”",
          "start_ms": 11440,
          "end_ms": 22680
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ginbasa ni Riza ang tagubilin kag ginklaro ang indi sigurado.",
          "start_ms": 22980,
          "end_ms": 28300
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ang tubig nga nagtipon isa ka obserbasyon; indi ini pamatuod nga may balatian ang mga residente.",
          "start_ms": 28600,
          "end_ms": 35760
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Ano nga mga katungdanan ang kinahanglan agod masunod ang bug-os nga tagubilin?",
          "start_ms": 36060,
          "end_ms": 41540
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Basaha kag klaruhon ang tagubilin; ilain ang nakita sa pagpangagpas.",
          "start_ms": 41840,
          "end_ms": 48160
        }
      ]
    },
    "applied-education": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/applied-education.hil.43ef39531bf6.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "43ef39531bf66e00ce2bcea040db8fd10240c5901c522b6368ccc084690d410d",
      "sha256": "af9f0cae360d90b1aea1a136765bd5630c5ca9bddbe050afe0558bad81c079fd",
      "duration_seconds": 47.542857142857144,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Magpamati antes magpaathag",
          "start_ms": 0,
          "end_ms": 3120
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Ginpamangkot ni Riza ang pamilya: “Ano ang inyo natalupangdan parte sa tubig nga nagatipon diri?",
          "start_ms": 3420,
          "end_ms": 10540
        },
        {
          "zone": "body",
          "index": 1,
          "text": "May gusto bala kamo ipamangkot sa health team?”",
          "start_ms": 10840,
          "end_ms": 13960
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Nagpamati anay siya, dayon naggamit sang mensahe nga aprubado sang health team kag pagpaathag nga nagakaigo sa iya kaistorya.",
          "start_ms": 14260,
          "end_ms": 23660
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kon indi siya sigurado sa sabat, ipamangkot niya ini sa health team.",
          "start_ms": 23960,
          "end_ms": 28920
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Amo ini ang katungdanan nga Health Educator: buligan ang pamilya nga mahangpan ang mensahe kag hibaluan kon ano pa ang kinahanglan klaruhon.",
          "start_ms": 29220,
          "end_ms": 39260
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Health Educator: magpamati, gamita ang aprubado nga mensahe, kag klaruhon ang mga pamangkot.",
          "start_ms": 39560,
          "end_ms": 47480
        }
      ]
    },
    "applied-organizing": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/applied-organizing.hil.4c3ac473e838.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "4c3ac473e838a113338d4788858f5556f01c4848eb54601bf92b35fe4c9fc161",
      "sha256": "42f1bab58a9f8fccd00ad684ea9e3f2efab03b3fa2784ec27c6b0a58c817acc6",
      "duration_seconds": 47.51673469387755,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Agdaha ang mga mahimo nga kabulig",
          "start_ms": 0,
          "end_ms": 2840
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Para sa tingob nga paghisugilanon, nakig-istorya si Riza sa mga residente, purok leader, kagawad, kag health staff.",
          "start_ms": 3140,
          "end_ms": 11980
        },
        {
          "zone": "body",
          "index": 1,
          "text": "“San-o kita mahimo mag-istorya parte sa aton nakita kag sa mahimo himuon?”",
          "start_ms": 12280,
          "end_ms": 17880
        },
        {
          "zone": "body",
          "index": 2,
          "text": "pamangkot niya.",
          "start_ms": 18180,
          "end_ms": 19620
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ginpamatian niya ang ila mga panugyan parte sa tion kag buluhaton antes magkasugot.",
          "start_ms": 19920,
          "end_ms": 25760
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Amo ini ang katungdanan nga Community Organizer: anguton ang mga tawo kag dasigon ang ila pagpakigbahin.",
          "start_ms": 26060,
          "end_ms": 33820
        },
        {
          "zone": "body",
          "index": 5,
          "text": "Indi niya pagkabigon nga ginkasugtan na ang isa ka buluhaton kon wala pa ini nahisugilan.",
          "start_ms": 34120,
          "end_ms": 39800
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Community Organizer: mag-agda, magpamati, kag magkasugot upod sa mga tawo.",
          "start_ms": 40100,
          "end_ms": 47460
        }
      ]
    },
    "next-learning": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/next-learning.hil.5e37e973fef1.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "5e37e973fef1e5cd29b4ec449ae7b927d86f652ddc43109585349f6a8bd53ddd",
      "sha256": "669383995320abc5bcd07853ef010065b4cb0927795a250a402500474998b79e",
      "duration_seconds": 60.7869387755102,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Maggiya kag irekord ang ginhimo",
          "start_ms": 0,
          "end_ms": 3200
        },
        {
          "zone": "body",
          "index": 0,
          "text": "May residente nga gusto makaistorya ang health team.",
          "start_ms": 3500,
          "end_ms": 6820
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ginkumpirma ni Riza sa midwife ang nagakaigo nga contact kag lokal nga paagi sang pagpakig-angot, dayon ginpaathag ang masunod nga tikang sa residente.",
          "start_ms": 7120,
          "end_ms": 17080
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ginrekord niya ang nakita, ang pamangkot, kag ang aktwal nga ginhimo suno sa tagubilin; wala niya ginsulat nga may serbisyo nga nahatag kon wala man.",
          "start_ms": 17380,
          "end_ms": 27780
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Amo ini ang katungdanan nga Health Service Provider: maggiya kag magbulig sa health team sa sakop sang iya paghanas.",
          "start_ms": 28080,
          "end_ms": 37080
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Ang pagpili sang rekord may kaangtanan sa leksiyon 1.1.5; ang mas madalom nga komunikasyon, community mobilization, kag pagtudlo parte sa health promotion pagatun-an sa masunod nga mga leksiyon.",
          "start_ms": 37380,
          "end_ms": 52420
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Health Service Provider: siguroha ang contact, ipaathag ang tikang, kag irekord ang aktwal nga ginhimo.",
          "start_ms": 52720,
          "end_ms": 60720
        }
      ]
    },
    "handover": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/handover.hil.7be17a41f935.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "7be17a41f935fa051f1407c0444adad4816a70a9847a37152afc6b13e2d74aac",
      "sha256": "39312b105fdcde7bbc64655429bad5bdb0bf74e714c1eadf8e7516237c8be431",
      "duration_seconds": 53.34204081632653,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Nakita, ginhimo, kag kinahanglan",
          "start_ms": 0,
          "end_ms": 4800
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Nagreport si Riza sa midwife: “May tubig nga nagtipon sa tatlo ka lagwerta.",
          "start_ms": 5100,
          "end_ms": 10620
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ginrekord ko ang obserbasyon, nagpamati sa mga pamangkot, kag nakig-istorya sa mga mahimo nga kabulig.",
          "start_ms": 10920,
          "end_ms": 19000
        },
        {
          "zone": "body",
          "index": 2,
          "text": "May residente nga gusto makaistorya ang health team; ginpaathag ko ang contact nga inyo ginkumpirma.",
          "start_ms": 19300,
          "end_ms": 26460
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kinahanglan ko pa sang giya sa masunod nga tikang.”",
          "start_ms": 26760,
          "end_ms": 30280
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Itandi ang report sa rekord kag sa tagubilin.",
          "start_ms": 30580,
          "end_ms": 34340
        },
        {
          "zone": "body",
          "index": 5,
          "text": "Ipaambit lamang ang may kaangtanan nga impormasyon sa husto nga magabaton.",
          "start_ms": 34640,
          "end_ms": 40040
        },
        {
          "zone": "body",
          "index": 6,
          "text": "Ipaathag kon diin niya gingamit ang kada katungdanan kag kon ano pa ang wala matapos.",
          "start_ms": 40340,
          "end_ms": 46380
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Malip-ot nga handover: nakita + aktwal nga ginhimo + aksyon nga kinahanglan pa.",
          "start_ms": 46680,
          "end_ms": 53280
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/check.hil.097e865b9379.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "097e865b9379953af716e3957830536ee15549cf8fc49bb502ea32fb1fb6b010",
      "sha256": "bbc80e4bf1adb780769164617963b765927cc839c84b182d24066b906b262152",
      "duration_seconds": 47.22938775510204,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita kag ipaathag ang mga katungdanan",
          "start_ms": 0,
          "end_ms": 3520
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Subong, ikaw naman.",
          "start_ms": 3820,
          "end_ms": 5900
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Pilia ang report nga nagasabat sa bug-os nga tagubilin, dayon ihambal ang imo kaugalingon nga handover gamit ang nakita, ginhimo, kag kinahanglan.",
          "start_ms": 6200,
          "end_ms": 17000
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ipaathag kon diin ang buluhaton nga Health Educator, Community Organizer, kag Health Service Provider.",
          "start_ms": 17300,
          "end_ms": 25380
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ang online nga pamangkot paghanda para sa paghanas.",
          "start_ms": 25680,
          "end_ms": 30080
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Separado nga obserbahan sang facilitator ang imo aktwal nga pagganap; ang pagkompleto sang leksiyon indi pamatuod sang praktikal nga ikasarang.",
          "start_ms": 30380,
          "end_ms": 40540
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Pilia ang katungdanan, sundon ang tagubilin, irekord, kag ireport ang kinahanglan.",
          "start_ms": 40840,
          "end_ms": 47160
        }
      ]
    }
  },
