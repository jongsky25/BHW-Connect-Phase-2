{
  "narration": {
    "applied-observation": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/applied-observation.ceb.5ba3826b050a.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "5ba3826b050a506771cc642cea879f2d47d3c9998c19988518a906bfedc20492",
      "sha256": "e8bf2795cc78faf094bb0bd53139327b11c806ec9a8ca0e4c6aafe4011435c2e",
      "duration_seconds": 48.22204081632653,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Usa ka obserbasyon, tulo ka tahas",
          "start_ms": 0,
          "end_ms": 3480
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Sa pagbisita sa purok, namatikdan ni BHW Riza ang tubig nga natigom sa tulo ka nataran.",
          "start_ms": 3780,
          "end_ms": 10340
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Tagubilin sa midwife: “Irekord ang nakita, pangutana kon adunay gustong makig-istorya sa health team, ug ireport kanako ang gikinahanglan pa nga aksyon.”",
          "start_ms": 10640,
          "end_ms": 22600
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Gibasa ni Riza ang tagubilin ug giklaro ang dili sigurado.",
          "start_ms": 22900,
          "end_ms": 27620
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ang tubig nga natigom usa ka obserbasyon; dili kini pamatuod nga adunay sakit ang mga residente.",
          "start_ms": 27920,
          "end_ms": 35320
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Unsa nga mga tahas ang gikinahanglan aron masunod ang tibuok tagubilin?",
          "start_ms": 35620,
          "end_ms": 41180
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Basaha ug klaroha ang tagubilin; ilain ang nakita gikan sa pangagpas.",
          "start_ms": 41480,
          "end_ms": 48160
        }
      ]
    },
    "applied-education": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/applied-education.ceb.103b52302395.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "103b52302395d5b3d0672458b55fdf98e40a9517f24e0536b1c78e8340b1270a",
      "sha256": "8965eadf09be8c06e2b95783347199ab22764c5ded3fe8b865156fbac7fb9aa4",
      "duration_seconds": 46.26285714285714,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Paminaw sa dili pa mopasabot",
          "start_ms": 0,
          "end_ms": 2720
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Gipangutana ni Riza ang pamilya: “Unsa ang inyong namatikdan bahin sa tubig nga natigom dinhi?",
          "start_ms": 3020,
          "end_ms": 10820
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Aduna ba kamoy gustong ipangutana sa health team?”",
          "start_ms": 11120,
          "end_ms": 14280
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Naminaw una siya, dayon migamit og mensaheng aprubado sa health team ug pagpasabot nga angay sa iyang kaistorya.",
          "start_ms": 14580,
          "end_ms": 23100
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kon dili siya sigurado sa tubag, mangutana siya sa health team.",
          "start_ms": 23400,
          "end_ms": 28320
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Kini ang tahas nga Health Educator: tabangan ang pamilya nga makasabot sa mensahe ug hibaloon kon unsa pa ang kinahanglan klarohon.",
          "start_ms": 28620,
          "end_ms": 38220
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Health Educator: paminaw, gamita ang aprubadong mensahe, ug klaroha ang mga pangutana.",
          "start_ms": 38520,
          "end_ms": 46200
        }
      ]
    },
    "applied-organizing": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/applied-organizing.ceb.69fbd6f76e5f.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "69fbd6f76e5feac3a1fb9fb07a98de5582243c27b0e60a43a5a8ebbbbf8f42f7",
      "sha256": "9211195be9fec98f44c01b0c239dadc59746905309f28e0db685be6e4bf7843a",
      "duration_seconds": 46.75918367346939,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Dapita ang mga mahimong kaabag",
          "start_ms": 0,
          "end_ms": 3040
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Alang sa hiniusang paghisgot, nakig-istorya si Riza sa mga residente, purok leader, kagawad, ug health staff.",
          "start_ms": 3340,
          "end_ms": 12820
        },
        {
          "zone": "body",
          "index": 1,
          "text": "“Kanus-a man kita mahimong maghisgot bahin sa atong nakita ug sa mahimong buhaton?”",
          "start_ms": 13120,
          "end_ms": 18720
        },
        {
          "zone": "body",
          "index": 2,
          "text": "pangutana niya.",
          "start_ms": 19020,
          "end_ms": 20580
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Gipaminaw niya ang ilang mga sugyot bahin sa oras ug buluhaton sa dili pa magkauyon.",
          "start_ms": 20880,
          "end_ms": 27640
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Kini ang tahas nga Community Organizer: sumpayon ang mga tawo ug dasigon ang ilang pag-apil.",
          "start_ms": 27940,
          "end_ms": 35260
        },
        {
          "zone": "body",
          "index": 5,
          "text": "Dili niya isipon nga gikauyonan na ang usa ka buluhaton kon wala pa kini mahisgoti.",
          "start_ms": 35560,
          "end_ms": 41560
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Community Organizer: pagdapit, paminaw, ug pakig-uyon uban sa mga tawo.",
          "start_ms": 41860,
          "end_ms": 46700
        }
      ]
    },
    "next-learning": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/next-learning.ceb.662a5e953fff.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "662a5e953fffff0df9a96eed437264645a2183c4f3f4aa67e6e1787cad397449",
      "sha256": "66539cba83552bbfbf163c32d822faac3362b1d87706c23c2816375c7fb56448",
      "duration_seconds": 59.5330612244898,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Giya ug irekord ang gibuhat",
          "start_ms": 0,
          "end_ms": 3040
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Adunay residente nga gustong makig-istorya sa health team.",
          "start_ms": 3340,
          "end_ms": 7620
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Gikumpirma ni Riza sa midwife ang angay nga contact ug lokal nga paagi sa pakig-ugnayan, dayon gipasabot ang sunod nga lakang sa residente.",
          "start_ms": 7920,
          "end_ms": 18280
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Girekord niya ang nakita, ang pangutana, ug ang aktwal nga gibuhat sumala sa tagubilin; wala niya isulat nga adunay serbisyo nga nahatag kon wala man.",
          "start_ms": 18580,
          "end_ms": 30260
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kini ang tahas nga Health Service Provider: mogiya ug motabang sa health team sulod sa iyang pagsasanay.",
          "start_ms": 30560,
          "end_ms": 38240
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Ang pagpili sa rekord adunay kalabotan sa leksiyon 1.1.5; ang mas lawom nga komunikasyon, community mobilization, ug pagtudlo bahin sa health promotion tun-an sa umaabot nga mga leksiyon.",
          "start_ms": 38540,
          "end_ms": 53220
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Health Service Provider: siguroha ang contact, ipasabot ang lakang, ug irekord ang aktwal nga gibuhat.",
          "start_ms": 53520,
          "end_ms": 59480
        }
      ]
    },
    "handover": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/handover.ceb.53f136bef6f4.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "53f136bef6f4fd47c35c703e3fd86420dc770fcc9e8d289bc1ca817c53eb18f6",
      "sha256": "c2be01b0566f3b3057fee3097db7747d246d31cc7a745bc68003e6706a8e8234",
      "duration_seconds": 56.65959183673469,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Nakita, gibuhat, ug gikinahanglan",
          "start_ms": 0,
          "end_ms": 5480
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Mireport si Riza sa midwife: “Adunay tubig nga natigom sa tulo ka nataran.",
          "start_ms": 5780,
          "end_ms": 11740
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Girekord nako ang obserbasyon, naminaw sa mga pangutana, ug nakig-istorya sa mga mahimong kaabag.",
          "start_ms": 12040,
          "end_ms": 20240
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Adunay residente nga gustong makig-istorya sa health team; gipasabot nako ang contact nga inyong gikumpirma.",
          "start_ms": 20540,
          "end_ms": 28460
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Kinahanglan pa nako og giya sa sunod nga lakang.”",
          "start_ms": 28760,
          "end_ms": 32120
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Itandi ang report sa rekord ug sa tagubilin.",
          "start_ms": 32420,
          "end_ms": 36620
        },
        {
          "zone": "body",
          "index": 5,
          "text": "Ipaambit lamang ang may kalabotang impormasyon ngadto sa hustong modawat.",
          "start_ms": 36920,
          "end_ms": 42120
        },
        {
          "zone": "body",
          "index": 6,
          "text": "Ipasabot kon asa niya gigamit ang matag tahas ug kon unsa pa ang wala mahuman.",
          "start_ms": 42420,
          "end_ms": 48540
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mubo nga handover: nakita + aktwal nga gibuhat + aksyon nga gikinahanglan pa.",
          "start_ms": 48840,
          "end_ms": 56600
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-application/check.ceb.dc982491f144.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "dc982491f144c6358bceb185a52a6b413bccdb1f1ee3d35b32c939526f1bbc53",
      "sha256": "4f9d3e285e14d71888fa207294b09dc7a7ead4bcb95477d8f2d5a4446f024ed7",
      "duration_seconds": 47.85632653061224,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ug ipasabot ang mga tahas",
          "start_ms": 0,
          "end_ms": 2880
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Karon, ikaw na usab.",
          "start_ms": 3180,
          "end_ms": 5460
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Pilia ang report nga motubag sa tibuok tagubilin, dayon isulti ang imong kaugalingong handover gamit ang nakita, gibuhat, ug gikinahanglan.",
          "start_ms": 5760,
          "end_ms": 16400
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ipasabot kon hain ang buluhaton nga Health Educator, Community Organizer, ug Health Service Provider.",
          "start_ms": 16700,
          "end_ms": 24660
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ang online nga pangutana usa ka pagpangandam alang sa pagpraktis.",
          "start_ms": 24960,
          "end_ms": 30240
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Lahi nga obserbahan sa facilitator ang imong aktwal nga paglihok; ang pagkahuman sa leksiyon dili pamatuod sa praktikal nga kahanas.",
          "start_ms": 30540,
          "end_ms": 40260
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Pilia ang tahas, sunda ang tagubilin, irekord, ug ireport ang gikinahanglan.",
          "start_ms": 40560,
          "end_ms": 47800
        }
      ]
    }
  },
