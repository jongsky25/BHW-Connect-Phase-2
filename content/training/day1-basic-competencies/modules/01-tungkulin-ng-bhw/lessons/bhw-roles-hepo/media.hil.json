{
  "narration": {
    "morning": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-hepo/morning.hil.c6c9da67cf07.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "c6c9da67cf07dc7777380d3dfa33cc196eb24bcc320bec8352380a09e1127314",
      "sha256": "40724510e5368833d2b315e3c483430021c7ad4f7cb46ac5c89d24945622cfae",
      "duration_seconds": 51.5134693877551,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Isa ka aga, madamo nga buluhaton",
          "start_ms": 0,
          "end_ms": 3240
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Alas-otso sang aga, may paghisugilanon parte sa panglawas si BHW Riza sa purok.",
          "start_ms": 3540,
          "end_ms": 10820
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Alas-diyes, nakighambal siya sa kagawad parte sa clean-up drive.",
          "start_ms": 11120,
          "end_ms": 15720
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Alas-onse, ginbuligan niya si Aling Nena nga makighambal sa midwife parte sa kinahanglanon sang iya bata.",
          "start_ms": 16020,
          "end_ms": 23700
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Isa lang ka BHW ang naghimo sining tatlo ka buluhaton.",
          "start_ms": 24000,
          "end_ms": 28720
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Sa kurikulum, ang katuyuan sang UHC amo ang pagpalig-on sang primary care kag pagpauswag sang panglawas; gani mas malapad ang papel sang BHW kaysa sa pagbulig lamang sa serbisyo.",
          "start_ms": 29020,
          "end_ms": 42260
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Kabahin sang buluhaton sang BHW ang pagtudlo kag paghulag upod sa komunidad, dugang sa pagbulig sa serbisyo.",
          "start_ms": 42560,
          "end_ms": 51440
        }
      ]
    },
    "prevention": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-hepo/prevention.hil.598ee6180ed0.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "598ee6180ed09462e08fe5a292724975a047f24a1674383591ea89818668e610",
      "sha256": "6c8f34d87d59bbc7109843f8cac8047f1e98a3223fa9425eacb10b178d66ce00",
      "duration_seconds": 44.773877551020405,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Maghulag upod sa komunidad",
          "start_ms": 0,
          "end_ms": 2760
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Kon nagakinahanglan sang pag-atipan ang mga residente, ginabuligan sila sang BHW nga makapalapit sa serbisyo sa panglawas.",
          "start_ms": 3060,
          "end_ms": 12220
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Nagatudlo man ang BHW kag nagadasig sa mga tawo nga mag-upod sa mga hilikuton para sa panglawas.",
          "start_ms": 12520,
          "end_ms": 20240
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Sa pagpaninlo sang barangay, nagapaambit si Riza sang impormasyon kag nagaagda sa mga residente nga magplano kag maghulag upod sa iya.",
          "start_ms": 20540,
          "end_ms": 30540
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Sa sini nga mga buluhaton, nagaangot ang edukasyon, pagpakigbahin sang komunidad, kag pagpalapit sa serbisyo.",
          "start_ms": 30840,
          "end_ms": 38480
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ang pagtudlo kag pag-organisa nagabulig sa pagpauswag sang panglawas.",
          "start_ms": 38780,
          "end_ms": 44700
        }
      ]
    },
    "hepo": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-hepo/hepo.hil.49bfb6ef3e53.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "49bfb6ef3e53cc1f0caf1f1b3c6db281a1922325a556a9af4dde587b2bdcbb88",
      "sha256": "6302e090d9788f970d287b1147af35e25e933c6af791f5a70ff5dc230f669458",
      "duration_seconds": 58.331428571428575,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "HEPO: pagpauswag sang panglawas",
          "start_ms": 0,
          "end_ms": 4280
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Ginagamit sang Reference Manual ang tawag nga barangay-level Health Education and Promotion Officer ukon HEPO.",
          "start_ms": 4580,
          "end_ms": 13540
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ginapaathag sini ang papel sang BHW sa pagpaambit sang impormasyon parte sa panglawas.",
          "start_ms": 13840,
          "end_ms": 21240
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Makita ini sa iya mga papel bilang Health Educator, Community Organizer, kag Health Service Provider.",
          "start_ms": 21540,
          "end_ms": 29620
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Ang koneksiyon nga ginapakita sa laragway nagakahulugan sang nagaangot nga mga buluhaton; indi ini opisyal nga organizational chart ukon pamatuod sang pormal nga pagtangdo sa posisyon.",
          "start_ms": 29920,
          "end_ms": 43000
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ang HEPO nagakahulugan sang Health Education and Promotion Officer. Ginapaathag sini ang nagaangot nga mga buluhaton sang BHW sa pagtudlo, pag-organisa, kag pagbulig sa serbisyo.",
          "start_ms": 43300,
          "end_ms": 58260
        }
      ]
    },
    "knowledge": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-hepo/knowledge.hil.2e25e20e3662.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "2e25e20e36621cba87d0658a94eb9fb0eabb8c4121551bdb5454195e8cce3d9b",
      "sha256": "fd59288f641ec01a5e3eb478b9e29d1728f0f773ccdf8f0b8371b6e80181fde8",
      "duration_seconds": 35.91836734693877,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Antes magpaambit, maghanda",
          "start_ms": 0,
          "end_ms": 2480
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Kinahanglan ni Riza sang bastante nga ihibalo parte sa mga prayoridad nga programa kag mga problema sa panglawas sa barangay.",
          "start_ms": 2780,
          "end_ms": 10700
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Antes magtudlo, ginasiguro niya nga maathag sa iya ang impormasyon nga iya ipaambit.",
          "start_ms": 11000,
          "end_ms": 17040
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Kon may detalye nga indi siya sigurado, ginakumpirma niya ini sa nagakaigo nga health worker kag ginagamit ang gin-aprobahan nga materyal.",
          "start_ms": 17340,
          "end_ms": 26620
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Indi kinahanglan magpakot sang sabat agod makabulig.",
          "start_ms": 26920,
          "end_ms": 30720
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ang bastante nga ihibalo amo ang pundasyon sang tatlo ka papel.",
          "start_ms": 31020,
          "end_ms": 35860
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-roles-hepo/check.hil.6c59faeddf83.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "6c59faeddf83aeddf64c2c56a3c3ddb010c610a58da9bb1845650aec62a0934e",
      "sha256": "6a6b5359532897e036a1e141b68851683eaf90dc9d26688b0e288d6f397573af",
      "duration_seconds": 24.76408163265306,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imo natun-an",
          "start_ms": 0,
          "end_ms": 2600
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Gintipon ni Riza ang mga residente agod magplano sang pagpaninlo sang barangay.",
          "start_ms": 2900,
          "end_ms": 9100
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Ano nga papel sang BHW ang pinakamaathag nga makita sa sini nga buluhaton?",
          "start_ms": 9400,
          "end_ms": 14400
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Mahimo nga iupod sang BHW ang pagtudlo, pag-organisa sang komunidad, kag pagbulig sa serbisyo agod mapauswag ang panglawas.",
          "start_ms": 14700,
          "end_ms": 24700
        }
      ]
    }
  },
