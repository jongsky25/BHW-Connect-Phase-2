{
  "narration": {
    "record-purpose": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/record-purpose.hil.50b26a9d9f19.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "50b26a9d9f19540cdc86927c52d1a172d9894a531cd5e62550a3132cbd3cc994",
      "sha256": "1e271912cf079ce0079c81fb88ac557f831475f93bdd25f70b579693f1883db4",
      "duration_seconds": 46.78530612244898,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Pagkatapos sang pagbisita",
          "start_ms": 0,
          "end_ms": 2560
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Pagkatapos makaistorya si Aling Nena, nagbalik si BHW Riza sa health station.",
          "start_ms": 2860,
          "end_ms": 9300
        },
        {
          "zone": "body",
          "index": 1,
          "text": "May hinimo siya nga rekord sang ila ginhisugilan, pero indi niya ini basta ibutang sa bisan diin nga listahan.",
          "start_ms": 9600,
          "end_ms": 17480
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ginpamangkot niya ang midwife: “Ano nga impormasyon ang kinahanglan, kag diin ini gamiton?”",
          "start_ms": 17780,
          "end_ms": 24620
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Importante ang husto nga rekord sa paghangop sang mga kinahanglanon sang komunidad kag sa pagplano sang programa.",
          "start_ms": 24920,
          "end_ms": 32920
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Hinimo lamang ang tanan nga halimbawa sa sini nga leksiyon; wala ini sang matuod nga personal nga datos ukon opisyal nga form.",
          "start_ms": 33220,
          "end_ms": 41540
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ang rekord may pamangkot nga ginasabat kag tawo nga magagamit sini.",
          "start_ms": 41840,
          "end_ms": 46720
        }
      ]
    },
    "household-profile": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/household-profile.hil.30b7bab93b91.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "30b7bab93b915498d33898acf005a66680da189246eb223cb8c56beee9976fbb",
      "sha256": "457f064a42638d0f0dc18b930c4c0e2388a4bb7496e600e0a06161a4372a29fa",
      "duration_seconds": 42.39673469387755,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Ano ang laragway sang panimalay?",
          "start_ms": 0,
          "end_ms": 2760
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Una nga gintan-aw ni Riza ang household profile.",
          "start_ms": 3060,
          "end_ms": 6740
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Sa hinimo nga halimbawa, ang code nga HH-014 nagatumod sa isa ka panimalay nga may apat ka miyembro.",
          "start_ms": 7040,
          "end_ms": 17080
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Makabulig ini agod makita ang laragway sang panimalay.",
          "start_ms": 17380,
          "end_ms": 21740
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Indi sini masabat kon sin-o ang nakabaton na sang serbisyo.",
          "start_ms": 22040,
          "end_ms": 26560
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Ang matuod nga mga field kag paagi sang pagtipig nagasunod sa aprubado nga lokal nga form kag tagubilin.",
          "start_ms": 26860,
          "end_ms": 34300
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Household profile: laragway sang isa ka panimalay, indi pamatuod nga may serbisyo nga nahatag.",
          "start_ms": 34600,
          "end_ms": 42320
        }
      ]
    },
    "master-list": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/master-list.hil.17e97043b03d.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "17e97043b03ddfedaa10ef3cc6e397056586ab6032d7a973c4a4e8891fd54078",
      "sha256": "e70470ce82ca0eefd11dc960908c1c80f658b1863eba3553d2bced7634347088",
      "duration_seconds": 35.00408163265306,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Sin-o ang kabahin sang grupo?",
          "start_ms": 0,
          "end_ms": 2440
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Masunod, nakita ni Riza ang master list para sa isa ka grupo, pareho sang mga tigulang sa purok.",
          "start_ms": 2740,
          "end_ms": 10780
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Suno sa manwal, ginatipon sang master list ang mga tawo suno sa grupo.",
          "start_ms": 11080,
          "end_ms": 16600
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Magamit ini kon ang pamangkot amo kon sin-o ang kabahin sang amo nga grupo.",
          "start_ms": 16900,
          "end_ms": 22820
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Indi igo ang pagkakalista diri agod masiling nga nakabaton na sila sang health teaching ukon iban nga serbisyo.",
          "start_ms": 23120,
          "end_ms": 30360
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Master list: sin-o ang kabahin sang isa ka grupo.",
          "start_ms": 30660,
          "end_ms": 34940
        }
      ]
    },
    "registry": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/registry.hil.b91877cccce2.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "b91877cccce255157c4359cd47202e1ecc6b16ca4aa35b4a8d0bab146ae294c1",
      "sha256": "488bab82d9c78be5a121ebaa3ef8ff676db866f2baceb4fc4554a7cf75c2f257",
      "duration_seconds": 40.51591836734694,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Sin-o ang nakabaton sang serbisyo?",
          "start_ms": 0,
          "end_ms": 2680
        },
        {
          "zone": "body",
          "index": 0,
          "text": "“Sin-o na ang nakabaton sang health teaching?”",
          "start_ms": 2980,
          "end_ms": 6180
        },
        {
          "zone": "body",
          "index": 1,
          "text": "pamangkot sang midwife.",
          "start_ms": 6480,
          "end_ms": 8560
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ang registry ang tan-awon ni Riza: suno sa manwal, amo ini ang rekord sang mga tawo nga nakabaton sang serbisyo.",
          "start_ms": 8860,
          "end_ms": 17340
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Usisaon niya ang ginrekord nga serbisyo antes magsabat.",
          "start_ms": 17640,
          "end_ms": 21600
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Kon may detalye nga indi maathag, klaruhon anay niya ini sa health team; indi niya pagkuhaon ang sabat halin sa master list ukon magdugang sang entry suno sa pagpangagpas.",
          "start_ms": 21900,
          "end_ms": 33580
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Registry: sin-o ang nakabaton sang serbisyo, suno sa napamatud-an nga mga entry.",
          "start_ms": 33880,
          "end_ms": 40440
        }
      ]
    },
    "assigned-form": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/assigned-form.hil.e566769adae1.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "e566769adae10a653a0387c388caa4bae9c843de663b4c2b159d70638509db22",
      "sha256": "196e2440a99e29942de88abdecb99ad81133d3baffd80d2937b75db5e035cc89",
      "duration_seconds": 55.666938775510204,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Klaruhon antes ipasa",
          "start_ms": 0,
          "end_ms": 2880
        },
        {
          "zone": "body",
          "index": 0,
          "text": "May ginsugo man nga form nga may hinimo nga label nga “magabaton: midwife.”",
          "start_ms": 3180,
          "end_ms": 9260
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mahimo nga magpahimo ang nurse, midwife, ukon doktor sang form sang gobyerno, DOH, ukon lokal nga panguluhan.",
          "start_ms": 9560,
          "end_ms": 18800
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Antes ini ipasa, ginasiguro ni Riza kon ano nga impormasyon ang ginapangayo, kon nagatakdo ini sa napamatud-an nga rekord, kag kon sin-o ang magabaton.",
          "start_ms": 19100,
          "end_ms": 30220
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Indi niya pagpun-on sang pagpangagpas ang kulang.",
          "start_ms": 30520,
          "end_ms": 33640
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Sundon niya ang aprubado nga lokal nga paagi sang pagtipig kag pagpasa; ang halimbawa indi matuod nga form ukon pangkabilugan nga pagsulundan kon diin ipadala ang tanan nga rekord.",
          "start_ms": 33940,
          "end_ms": 47940
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Antes ipasa: siguroha ang ginapangayo nga detalye, magabaton, kag aprubado nga paagi.",
          "start_ms": 48240,
          "end_ms": 55600
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/check.hil.bf7e4c87644b.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "bf7e4c87644bbc27f23a929f09e061b76287f4491dce24f1c7197dc98cd24985",
      "sha256": "8d70dc10c132121574f6308d01d889d470ab31b62be1fb77d997e48b79d54c92",
      "duration_seconds": 28.708571428571428,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imo natun-an",
          "start_ms": 0,
          "end_ms": 2480
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Ginpangayo sang midwife kay Riza ang rekord kon sin-o ang nakabaton na sang health teaching.",
          "start_ms": 2780,
          "end_ms": 8420
        },
        {
          "zone": "body",
          "index": 1,
          "text": "May master list siya sang mga tigulang kag registry sang mga serbisyo nga nahatag, pero may isa ka entry sa registry nga indi maathag.",
          "start_ms": 8720,
          "end_ms": 19200
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ano ang pinakamaayo niya nga himuon?",
          "start_ms": 19500,
          "end_ms": 22700
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Pilia ang rekord suno sa pamangkot; siguroha ang detalye antes ipasa.",
          "start_ms": 23000,
          "end_ms": 28640
        }
      ]
    }
  },
