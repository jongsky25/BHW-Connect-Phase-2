{
  "narration": {
    "record-purpose": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/record-purpose.ceb.0b7a6e703e3c.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "0b7a6e703e3c7aeef988e06cf0dae4f813d02fa87581d5538bbc946a3b6c621b",
      "sha256": "99d6ad6841f3c9a8eaea0b37aa22d0a95336dff51a7536fccafb39c0a43a529f",
      "duration_seconds": 46.47183673469388,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Human sa pagbisita",
          "start_ms": 0,
          "end_ms": 1960
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Human makig-istorya kang Aling Nena, mibalik si BHW Riza sa health station.",
          "start_ms": 2260,
          "end_ms": 9020
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Aduna siyay hinimo nga rekord sa ilang gihisgotan, apan dili niya kini basta ibutang sa bisan unsang listahan.",
          "start_ms": 9320,
          "end_ms": 17280
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Gipangutana niya ang midwife: “Unsa nga impormasyon ang gikinahanglan, ug asa kini gamiton?”",
          "start_ms": 17580,
          "end_ms": 24940
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Importante ang hustong rekord sa pagsabot sa mga panginahanglan sa komunidad ug sa pagplano sa programa.",
          "start_ms": 25240,
          "end_ms": 32480
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Hinimo lamang ang tanang pananglitan niining leksiyona; wala kiniy tinuod nga personal nga datos o opisyal nga form.",
          "start_ms": 32780,
          "end_ms": 40500
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Ang rekord adunay pangutana nga gitubag ug tawo nga mogamit niini.",
          "start_ms": 40800,
          "end_ms": 46400
        }
      ]
    },
    "household-profile": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/household-profile.ceb.b15fb98ffba2.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "b15fb98ffba2f41f4081c08ffdad1dd9f4adfffbcceca53c1e4c20a41ca9b353",
      "sha256": "2a3bc3a5ff5e34e56db6288cdc836af5285966a035cfd966a7b6765a9dd1004c",
      "duration_seconds": 44.904489795918366,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Unsa ang hulagway sa panimalay?",
          "start_ms": 0,
          "end_ms": 3000
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Una nga gitan-aw ni Riza ang household profile.",
          "start_ms": 3300,
          "end_ms": 7020
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Sa hinimo nga pananglitan, ang code nga HH-014 nagtumong sa usa ka panimalay nga adunay upat ka miyembro.",
          "start_ms": 7320,
          "end_ms": 17760
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Makatabang kini aron makita ang hulagway sa panimalay.",
          "start_ms": 18060,
          "end_ms": 22500
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Dili kini motubag kon kinsa ang nakadawat na og serbisyo.",
          "start_ms": 22800,
          "end_ms": 27200
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Ang tinuod nga mga field ug paagi sa pagtipig mosunod sa aprubadong lokal nga form ug tagubilin.",
          "start_ms": 27500,
          "end_ms": 36260
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Household profile: hulagway sa usa ka panimalay, dili pamatuod nga adunay serbisyo nga nahatag.",
          "start_ms": 36560,
          "end_ms": 44840
        }
      ]
    },
    "master-list": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/master-list.ceb.fc9f696e7b1a.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "fc9f696e7b1abfbca92f3cfe3f0af7616afc03c73dfa58ed9a0a68a62f9fd9e0",
      "sha256": "efc368e7385fb33b08c81c9db171006a30261185011d3554e2cc2333adbec8de",
      "duration_seconds": 37.328979591836735,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Kinsa ang kabahin sa grupo?",
          "start_ms": 0,
          "end_ms": 2480
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Sunod, nakita ni Riza ang master list alang sa usa ka grupo, sama sa mga tigulang sa purok.",
          "start_ms": 2780,
          "end_ms": 10980
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Sumala sa manwal, gitigom sa master list ang mga tawo sumala sa grupo.",
          "start_ms": 11280,
          "end_ms": 16880
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Magamit kini kon ang pangutana mao kon kinsa ang kabahin nianang grupoha.",
          "start_ms": 17180,
          "end_ms": 23660
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Dili igo ang pagkakalista dinhi aron makaingon nga nakadawat na sila og health teaching o ubang serbisyo.",
          "start_ms": 23960,
          "end_ms": 32480
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Master list: kinsa ang kabahin sa usa ka grupo.",
          "start_ms": 32780,
          "end_ms": 37260
        }
      ]
    },
    "registry": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/registry.ceb.d9e62deb0681.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "d9e62deb0681b873999766776cdf9f0ead9d488ae333295a1f6adc2490b26798",
      "sha256": "5f35ca86887c519fa7e223a9898a6f5dfb808226bd6d5fb0541b976c6a244f4c",
      "duration_seconds": 41.87428571428571,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Kinsa ang nakadawat og serbisyo?",
          "start_ms": 0,
          "end_ms": 2760
        },
        {
          "zone": "body",
          "index": 0,
          "text": "“Kinsa na ang nakadawat og health teaching?”",
          "start_ms": 3060,
          "end_ms": 6420
        },
        {
          "zone": "body",
          "index": 1,
          "text": "pangutana sa midwife.",
          "start_ms": 6720,
          "end_ms": 8960
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Ang registry ang tan-awon ni Riza: sumala sa manwal, kini ang rekord sa mga tawo nga nakadawat og serbisyo.",
          "start_ms": 9260,
          "end_ms": 17700
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Susihon niya ang girekord nga serbisyo sa dili pa motubag.",
          "start_ms": 18000,
          "end_ms": 22440
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Kon adunay detalye nga dili tin-aw, klarohon una niya kini sa health team; dili niya kuhaon ang tubag gikan sa master list o magdugang og entry base sa pangagpas.",
          "start_ms": 22740,
          "end_ms": 34820
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Registry: kinsa ang nakadawat og serbisyo, base sa napamatud-ang mga entry.",
          "start_ms": 35120,
          "end_ms": 41800
        }
      ]
    },
    "assigned-form": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/assigned-form.ceb.d4411d3dc2cb.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "d4411d3dc2cb7158682f6d91aa7e8c96579af97858469b74fbedd4530f725581",
      "sha256": "3a6b1860b23d5f1eabed67804e8d575289a3384122c2b915060d1fa7e504f955",
      "duration_seconds": 55.222857142857144,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Klaroha sa dili pa ipasa",
          "start_ms": 0,
          "end_ms": 2600
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Aduna usab gisugo nga form nga adunay hinimo nga label nga “modawat: midwife.”",
          "start_ms": 2900,
          "end_ms": 9740
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Mahimong magpahimo ang nurse, midwife, o doktor og form sa gobyerno, DOH, o lokal nga panggamhanan.",
          "start_ms": 10040,
          "end_ms": 18920
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Sa dili pa kini ipasa, sigurohon ni Riza kon unsang impormasyon ang gipangayo, kon takdo kini sa napamatud-ang rekord, ug kon kinsa ang modawat.",
          "start_ms": 19220,
          "end_ms": 30660
        },
        {
          "zone": "body",
          "index": 3,
          "text": "Dili niya pun-on og pangagpas ang kulang.",
          "start_ms": 30960,
          "end_ms": 34200
        },
        {
          "zone": "body",
          "index": 4,
          "text": "Sundon niya ang aprubadong lokal nga paagi sa pagtipig ug pagpasa; ang pananglitan dili tinuod nga form o kinatibuk-ang lagda kon asa ipadala ang tanang rekord.",
          "start_ms": 34500,
          "end_ms": 47900
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Sa dili pa ipasa: siguroha ang gipangayong detalye, modawat, ug aprubadong paagi.",
          "start_ms": 48200,
          "end_ms": 55160
        }
      ]
    },
    "check": {
      "src": "/training/audio/01-tungkulin-ng-bhw/bhw-records/check.ceb.9e402e0c5a2b.mp3",
      "voice": "gemini:gemini-3.8-flash-tts:Kore",
      "content_hash": "9e402e0c5a2b27c4620aa3692db73ca4ed34017998e648af40971cdcc25d3370",
      "sha256": "57a8944e4dc7f09e0969909f9ca0763f9d349ce3ef974d48599c8b0561c16217",
      "duration_seconds": 29.231020408163264,
      "timings": [
        {
          "zone": "heading",
          "index": 0,
          "text": "Gamita ang imong nakat-onan",
          "start_ms": 0,
          "end_ms": 2480
        },
        {
          "zone": "body",
          "index": 0,
          "text": "Gipangayo sa midwife kang Riza ang rekord kon kinsa ang nakadawat na og health teaching.",
          "start_ms": 2780,
          "end_ms": 9460
        },
        {
          "zone": "body",
          "index": 1,
          "text": "Aduna siyay master list sa mga tigulang ug registry sa mga serbisyo nga nahatag, apan adunay usa ka entry sa registry nga dili tin-aw.",
          "start_ms": 9760,
          "end_ms": 19240
        },
        {
          "zone": "body",
          "index": 2,
          "text": "Unsa ang labing angay niyang buhaton?",
          "start_ms": 19540,
          "end_ms": 22780
        },
        {
          "zone": "takeaway",
          "index": 0,
          "text": "Pilia ang rekord sumala sa pangutana; siguroha ang detalye sa dili pa ipasa.",
          "start_ms": 23080,
          "end_ms": 29160
        }
      ]
    }
  },
